      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Locale</string>
          <string name="Source"><![CDATA[local entries = {
	loading={"Loading your factory…","Загружаем фабрику…"},
	balance={"BALANCE","БАЛАНС"}, income={"PER SECOND","В СЕКУНДУ"}, chest={"IN THE CHEST","В СУНДУКЕ"},
	floor={"Floor %d · %s","Этаж %d · %s"}, progress={"%d / 80 upgrades","Улучшения: %d / 80"},
	costumes={"Costumes","Костюмы"}, settings={"Settings","Настройки"}, teleport={"Teleport to Base","Телепорт на базу"},
	leaderboard={"Leaderboard","Лидеры"}, byCash={"By balance","По балансу"}, byStage={"By progress","По прогрессу"},
	equip={"Equip","Надеть"}, remove={"Remove","Снять"}, equipped={"Costume equipped","Костюм надет"},
	unequipped={"Costume removed","Костюм снят"}, lockedCostume={"Finish floor %d · $%s","Завершите этаж %d · $%s"},
	availableCostume={"Floor %d display · $%s","Витрина этажа %d · $%s"},
	language={"Language","Язык"}, music={"Music","Музыка"}, sound={"Sound effects","Звуковые эффекты"},
	access={"Base access","Доступ на базу"}, on={"On","Вкл"}, off={"Off","Выкл"},
	openState={"Open","Открыт"}, closedState={"Closed","Закрыт"}, doorLocked={"Unlock security doors on floor 1","Купите защитные двери на первом этаже"},
	claimed={"Plot claimed. Your factory is ready to build.","Участок занят. Можно строить фабрику."},
	collected={"+$%s collected","Получено +$%s"}, empty={"The chest is empty","Сундук пуст"},
	short={"You need more cash","Недостаточно денег"}, locked={"That upgrade is still locked","Улучшение пока недоступно"},
	owned={"Already purchased","Уже куплено"}, upgrade={"Built · %s","Построено · %s"},
	floorOpened={"Floor unlocked · %s","Открыт этаж · %s"}, costume={"Costume unlocked · %s","Костюм открыт · %s"},
	completed={"TYCOON COMPLETED","ФАБРИКА ЗАВЕРШЕНА"}, completeBody={"80 upgrades built. Your production is at full power!","Все 80 улучшений куплены. Фабрика работает на полную мощность!"},
	dismiss={"Continue","Продолжить"}, noPlot={"Claim a free plot first","Сначала займите свободный участок"},
	closed={"Base closed to visitors","База закрыта для посетителей"}, open={"Base open to visitors","База открыта для посетителей"},
	lift={"Lift arrived","Лифт прибыл"}, teleported={"Welcome back to your factory","Вы вернулись на свою фабрику"},
	tutorial0={"Follow the arrow to a free plot and activate Claim Tycoon.","Идите по стрелке к свободному участку и займите его."},
	tutorial1={"Activate the green pad to buy the starter conveyor for $1,000.","Купите стартовый конвейер за $1 000 на зелёной кнопке."},
	tutorial2={"Watch the conveyor. The first cash packet is on its way.","Следите за конвейером. Первая партия денег уже в пути."},
	tutorial3={"Go to Collect Cash and take your money. The next generator costs $500.","Подойдите к кассе и заберите деньги. Следующий генератор стоит $500."},
	tutorial4={"Collect more cash if needed, then buy the second generator for $500.","Заберите ещё денег из сундука, если нужно, и купите генератор за $500."},
}

return function(language,key,...)
	local pair = entries[key]
	local value = pair and pair[language == "ru" and 2 or 1] or key
	return select("#",...) > 0 and string.format(value,...) or value
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">NumberFormat</string>
          <string name="Source"><![CDATA[local units = {{1e12,"T"},{1e9,"B"},{1e6,"M"},{1e3,"K"}}

return function(value, exact)
	local amount = math.max(0, math.floor(value or 0))
	if exact then
		return (string.format("%.0f",amount):reverse():gsub("(%d%d%d)","%1 "):reverse():gsub("^ ",""))
	end
	for _, unit in ipairs(units) do
		if amount >= unit[1] then
			local scaled = math.floor(amount / unit[1] * 10) / 10
			return (string.format("%.1f", scaled):gsub("%.0$", "")) .. unit[2]
		end
	end
	return tostring(amount)
end
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">BrainrotServer</string>
      </Properties>
      <Item class="Script" referent="15">
        <Properties>
          <string name="Name">Boot</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local shared = game:GetService("ReplicatedStorage"):WaitForChild("Brainrot")
local network = Instance.new("Folder")
network.Name = "Network"
for _, name in ipairs({"Action","Feedback","WorldFX"}) do
	local event = Instance.new("RemoteEvent")
	event.Name = name
	event.Parent = network
end
network.Parent = shared

require(script.Parent.Services.TycoonService).start(network)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">CollectorService</string>
            <string name="Source"><![CDATA[local Economy = require(script.Parent.EconomyService)
local Tutorial = require(script.Parent.TutorialService)
local Collector = {}

function Collector.collect(plot, now)
	Economy.produce(plot, now)
	if plot.profile.Chest > 0 then Tutorial.advance(plot.profile, 3) end
	local amount = Economy.collect(plot.profile)
	if amount > 0 then Tutorial.advance(plot.profile, 4) end
	return amount
end

return Collector
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">ConveyorService</string>
            <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local Economy = require(script.Parent.EconomyService)
local Tutorial = require(script.Parent.TutorialService)
local Data = require(script.Parent.DataService)
local Conveyor = {}

function Conveyor.start(plots, onDeposit)
	local since = 0
	RunService.Heartbeat:Connect(function(dt)
		since += dt
		if since < .2 then return end
		since = 0
		local now = workspace:GetServerTimeNow()
		for _, plot in ipairs(plots) do
			if plot.owner and Data.get(plot.owner) and Economy.produce(plot, now) > 0 then
				Tutorial.advance(plot.profile, 3)
				onDeposit(plot)
			end
		end
	end)
end

return Conveyor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">CostumeService</string>
            <string name="Source"><![CDATA[local Assets = game:GetService("ServerStorage"):WaitForChild("FactoryAssets")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Brainrot")
local Costumes = require(Shared.CostumeConfig)
local Builder = require(Assets.CostumeBuilder)
local Costume = {}
local previous = setmetatable({}, {__mode="k"})
local ids = {}
for _, costume in ipairs(Costumes) do ids[costume.id] = true end

function Costume.valid(profile,id)
	return id == "" or ids[id] == true and profile.Costumes[id] == true
end

function Costume.apply(character,id)
	if not character or not character.Parent then return end
	local oldModel = character:FindFirstChild("FactoryCostume")
	if oldModel then oldModel:Destroy() end
	local original = previous[character]
	if original then
		for part, value in pairs(original) do
			if part:IsDescendantOf(character) then part.Transparency = value end
		end
	end
	previous[character] = nil
	if not ids[id] or not character:FindFirstChild("Head") then return end
	original = {}
	for _, item in ipairs(character:GetDescendants()) do
		if (item:IsA("BasePart") or item:IsA("Decal")) and item.Name ~= "HumanoidRootPart"
			and not item:FindFirstAncestorOfClass("Tool") then
			original[item] = item.Transparency
		end
	end
	Builder.wear(character,id)
	for item in pairs(original) do item.Transparency = 1 end
	previous[character] = original
end

function Costume.mask(profile)
	local mask = 0
	for floor, item in ipairs(Costumes) do
		if profile.Costumes[item.id] then mask += 2^(floor-1) end
	end
	return mask
end

return Costume
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Brainrot")
local Settings = require(Shared.GameConfig)
local Economy = require(Shared.EconomyConfig)
local Costumes = require(Shared.CostumeConfig)
local Profile = require(script.Parent.Profile)

local inMemory = RunService:IsStudio() and Settings.StudioMemory
local store
if not inMemory then
	store = DataStoreService:GetDataStore(RunService:IsStudio() and Settings.StudioDataStore or Settings.DataStore)
end
local memory, sessions = {}, {}
local Data = {}

local function update(key, transform)
	if inMemory then
		local result = transform(memory[key])
		if result ~= nil then memory[key] = result end
		return result
	end
	return store:UpdateAsync(key, transform)
end

local function retry(callback, label, attempts)
	for attempt = 1, attempts do
		local ok, result = pcall(callback)
		if ok then return true, result end
		warn(string.format("[Factory] DataStore %s (%d/%d): %s", label, attempt, attempts, tostring(result)))
		if attempt < attempts then task.wait(math.min(2 ^ (attempt - 1), 6)) end
	end
	return false
end

function Data.acquire(player)
	local userId = player.UserId
	if sessions[userId] then return nil, "busy" end
	local entry = { key = "player_" .. userId, token = HttpService:GenerateGUID(false), player = player, opening = true }
	sessions[userId] = entry
	local fallback = string.sub(string.lower(player.LocaleId), 1, 2) == "ru" and "ru" or "en"
	for attempt = 1, 5 do
		local rejection
		local ok, result = retry(function()
			return update(entry.key, function(current)
				rejection = nil
				local profile = Profile.read(current, Economy, Settings, Costumes, fallback)
				if not profile then
					rejection = "unsupported"
					return nil
				end
				local lease = current and current.Lease
				local now = os.time()
				if type(lease) == "table" and lease.Token ~= entry.token and type(lease.Expires) == "number" and lease.Expires > now then
					rejection = "busy"
					return nil
				end
				-- Atomic lease claim and migration. The callback never accepts a failed read.
				local record = Profile.snapshot(profile, Economy)
				record.Lease = { Token = entry.token, Expires = now + Settings.LeaseSeconds }
				return record
			end)
		end, "load", 3)
		if ok and result and result.Lease and result.Lease.Token == entry.token then
			entry.profile = Profile.read(result, Economy, Settings, Costumes, fallback)
			entry.expires, entry.opening = result.Lease.Expires, false
			return entry.profile
		end
		if not ok or rejection ~= "busy" or attempt == 5 then
			sessions[userId] = nil
			return nil, rejection or "offline"
		end
		task.wait(2 + attempt)
	end
end

function Data.get(player)
	local entry = sessions[player.UserId]
	if entry and entry.player == player and not entry.opening and not entry.closing and not entry.lost and os.time() < entry.expires - 9 then
		return entry.profile
	end
	return nil
end

local function save(entry, release)
	local snapshot = Profile.snapshot(entry.profile, Economy)
	local ok, result = retry(function()
		return update(entry.key, function(current)
			local lease = type(current) == "table" and current.Lease
			if type(lease) ~= "table" or lease.Token ~= entry.token then return nil end
			local nextRecord = table.clone(snapshot)
			if not release then
				nextRecord.Lease = { Token = entry.token, Expires = os.time() + Settings.LeaseSeconds }
			end
			return nextRecord
		end)
	end, release and "release" or "save", release and 4 or 3)
	if ok and result then
		if not release then entry.expires = result.Lease.Expires end
		return true
	end
	if ok and not result then entry.lost = true end
	return entry.lost == true
end

function Data.autosave(userId)
	local entry = sessions[userId]
	if not entry or entry.opening or entry.closing or entry.saving or entry.lost then return end
	entry.saving = true
	save(entry, false)
	entry.saving = false
end

function Data.release(player)
	local entry = sessions[player.UserId]
	if not entry or entry.player ~= player or entry.opening or entry.releasing then return end
	entry.closing, entry.releasing = true, true
	while entry.saving do task.wait(.1) end
	local done = entry.lost or save(entry, true)
	if done then
		sessions[player.UserId] = nil
	else
		entry.releasing = false
	end
end

function Data.maintain(closing)
	for userId, entry in pairs(sessions) do
		if entry.closing then
			task.spawn(Data.release, entry.player)
		elseif not entry.opening then
			if closing then
				task.spawn(Data.release, entry.player)
			else
				task.spawn(Data.autosave, userId)
			end
		end
	end
end

function Data.hasSessions()
	return next(sessions) ~= nil
end

return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">DropperService</string>
            <string name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")
local Dropper = {}

function Dropper.bind(model, plot)
	local marker = model:FindFirstChild("PacketStart")
	if marker then
		marker:SetAttribute("PlotId", plot.id)
		CollectionService:AddTag(marker, "FactoryLane")
	end
end

return Dropper
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">EconomyRules</string>
            <string name="Source"><![CDATA[return function(Config, Game)
	local Economy = {}

	function Economy.attach(plot, now)
		plot.production = {}
		if plot.profile.Stage == 0 then return end
		Economy.syncLanes(plot, now)
	end

	function Economy.syncLanes(plot, now)
		for floor, rate in ipairs(Config.Stages[plot.profile.Stage].laneRates) do
			if rate > 0 and not plot.production[floor] then
				local due = now + Game.PacketInterval
				plot.production[floor] = { last = now, due = due, remainder = 0, pending = 0 }
				plot.shell:SetAttribute("LaneEpoch" .. floor, now)
			end
		end
	end

	function Economy.produce(plot, now)
		local total = 0
		local rates = Config.Stages[plot.profile.Stage].laneRates
		for floor, lane in pairs(plot.production) do
			local rate = rates[floor]
			if now > lane.last then
				if now + 0.000001 >= lane.due then
					local batches = math.floor((now - lane.due + 0.000001) / Game.PacketInterval)
					local cutoff = lane.due + batches * Game.PacketInterval
					local earned = lane.pending + lane.remainder + (cutoff - lane.last) * rate
					local arrived = math.floor(earned + 0.000001)
					total += arrived
					lane.remainder = earned - arrived
					lane.pending = (now - cutoff) * rate
					lane.due = cutoff + Game.PacketInterval
				else
					lane.pending += (now - lane.last) * rate
				end
				lane.last = now
			end
		end
		plot.profile.Chest = math.min(Game.MaxCash, plot.profile.Chest + total)
		return total
	end

	function Economy.collect(profile)
		local amount = math.min(profile.Chest, Game.MaxCash - profile.Cash)
		profile.Cash += amount
		profile.Chest -= amount
		return amount
	end

	function Economy.buyUpgrade(profile, upgrade)
		if not upgrade or upgrade.index ~= profile.Stage + 1 then return false, "locked" end
		if profile.Cash < upgrade.price then return false, "short" end
		profile.Cash -= upgrade.price
		profile.Stage = upgrade.index
		return true
	end

	function Economy.buyCostume(profile, floor, costume)
		if profile.Stage < floor * 20 then return false, "locked" end
		if profile.Costumes[costume.id] then return false, "owned" end
		local price = Config.CostumePrices[floor]
		if profile.Cash < price then return false, "short" end
		profile.Cash -= price
		profile.Costumes[costume.id] = true
		return true
	end

	return Economy
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Brainrot")
return require(script.Parent.EconomyRules)(require(Shared.EconomyConfig), require(Shared.GameConfig))
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Brainrot")
local fmt = require(Shared.NumberFormat)
local Leaderboard = {}

function Leaderboard.sync(player, profile)
	local folder = player:FindFirstChild("leaderstats")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		for _, key in ipairs({"Cash","Factory %"}) do
			local item = Instance.new("IntValue")
			item.Name = key
			item.Parent = folder
		end
		folder.Parent = player
	end
	folder.Cash.Value = profile.Cash
	folder["Factory %"].Value = math.floor(profile.Stage * 100 / 80)
end

function Leaderboard.start(board)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "DistrictLeaderboard"
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(900,345)
	gui.LightInfluence = 0
	gui.MaxDistance = 130
	gui.Parent = board
	local rows = {}
	for index = 0,8 do
		local line = Instance.new("TextLabel")
		line.Size = UDim2.new(1,-36,0,index == 0 and 40 or 34)
		line.Position = UDim2.fromOffset(18,index == 0 and 7 or 48+(index-1)*35)
		line.BackgroundColor3 = index % 2 == 0 and Color3.fromRGB(41,58,85) or Color3.fromRGB(31,45,67)
		line.TextColor3 = index == 0 and Color3.fromRGB(103,240,185) or Color3.fromRGB(240,247,255)
		line.Font = Enum.Font.GothamBold
		line.TextSize = index == 0 and 29 or 24
		line.Text = index == 0 and "DISTRICT LEADERS  /  CASH  /  FACTORY" or "—"
		line.Parent = gui
		if index > 0 then
			rows[index] = line
		else
			line:SetAttribute("TextEN","DISTRICT LEADERS  /  CASH  /  FACTORY")
			line:SetAttribute("TextRU","ЛИДЕРЫ РАЙОНА  /  ДЕНЬГИ  /  ФАБРИКА")
			game:GetService("CollectionService"):AddTag(line,"FactoryText")
		end
	end
	task.spawn(function()
		while board.Parent do
			local entries = {}
			for _, player in ipairs(Players:GetPlayers()) do
				if player:GetAttribute("Ready") then table.insert(entries,player) end
			end
			table.sort(entries,function(a,b)
				local delta = a:GetAttribute("Cash") - b:GetAttribute("Cash")
				if delta ~= 0 then return delta > 0 end
				local stages = a:GetAttribute("Stage") - b:GetAttribute("Stage")
				if stages ~= 0 then return stages > 0 end
				return a.UserId < b.UserId
			end)
			for i, row in ipairs(rows) do
				local player = entries[i]
				row.Text = player and string.format("%d    %s    •    $%s    •    %d%%",i,player.DisplayName,
					fmt(player:GetAttribute("Cash")),math.floor(player:GetAttribute("Stage")*1.25)) or "—"
			end
			task.wait(2)
		end
	end)
end

return Leaderboard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Brainrot")
local Assets = game:GetService("ServerStorage"):WaitForChild("FactoryAssets")
local CollectionService = game:GetService("CollectionService")
local Config = require(Shared.GameConfig)
local Economy = require(Shared.EconomyConfig)
local Costumes = require(Shared.CostumeConfig)
local fmt = require(Shared.NumberFormat)
local World = require(Assets.WorldBuilder)
local Factory = require(Assets.FactoryBuilder)
local P = require(Assets.Parts)
local Dropper = require(script.Parent.DropperService)

local Plots = {}
local availableLabel, allPlots
local green, red = Color3.fromRGB(53, 232, 127), Color3.fromRGB(246, 90, 103)
local blue, violet = Color3.fromRGB(74, 215, 255), Color3.fromRGB(182, 121, 255)

local function button(parent, frame, kind, color, labelEn, labelRu, owner, onTrigger, price)
	local part = P.part(parent, kind, Vector3.new(4.7,.32,3.35), frame, color, Enum.Material.Neon, false)
	part:SetAttribute("Interaction",kind)
	part:SetAttribute("OwnerUserId",owner)
	CollectionService:AddTag(part,"FactoryButton")
	local title = P.billboard(part,"Title",labelEn,168,price and 52 or 35,2.48,35)
	P.translate(title,labelEn,labelRu)
	if price then
		part:SetAttribute("Price",price)
		part:SetAttribute("LabelEN",labelEn)
		part:SetAttribute("LabelRU",labelRu)
	end
	local prompt = P.make("ProximityPrompt",part,"Interact")
	prompt.AutoLocalize = false
	prompt.ActionText = labelEn:match("^[^\n]+") or labelEn
	prompt.ObjectText = price and "$" .. fmt(price,true) or ""
	prompt.MaxActivationDistance = Config.PromptDistance
	prompt.RequiresLineOfSight = false
	prompt.HoldDuration = .16
	P.translate(prompt,prompt.ActionText,labelRu:match("^[^\n]+") or labelRu,"ActionText")
	prompt.Triggered:Connect(function(player)
		onTrigger(player,part)
	end)
	return part
end

local function claimPad(plot, callbacks)
	plot.claim = button(plot.shell, plot.frame * CFrame.new(0,.51,35), "Claim", green,
		"Claim Tycoon","Занять участок",0,function(player,pad)
			callbacks.claim(player,plot,pad)
		end)
	plot.claim:SetAttribute("PlotId",plot.id)
end

function Plots.create(callbacks)
	local target, spawn, board, available = World.build()
	availableLabel = available
	local factories = P.make("Folder",target.Parent,"Factories")
	local plots = {}
	for id = 1, Config.PlotCount do
		local frame = World.plotFrame(id)
		local shell, ownerTitle = World.plotShell(target,id,frame)
		local plot = {id=id, frame=frame, shell=shell, title=ownerTitle, factories=factories}
		P.translate(plot.title,"FREE PLOT","СВОБОДНЫЙ УЧАСТОК")
		claimPad(plot,callbacks)
		table.insert(plots,plot)
	end
	allPlots = plots
	Plots.wayfinding()
	return plots, spawn, board
end

function Plots.wayfinding()
	local free = {}
	for _, plot in ipairs(allPlots) do
		if not plot.owner then table.insert(free,string.format("%02d",plot.id)) end
	end
	local suffix = table.concat(free," · ")
	local en = #free == 0 and "ALL PLOTS CLAIMED" or "OPEN PLOTS\n" .. suffix
	local ru = #free == 0 and "ВСЕ УЧАСТКИ ЗАНЯТЫ" or "СВОБОДНЫЕ УЧАСТКИ\n" .. suffix
	availableLabel.Text = en
	P.translate(availableLabel,en,ru)
end

function Plots.entry(plot)
	return plot.frame * CFrame.new(0,3.9,22) * CFrame.Angles(0,math.pi,0)
end

function Plots.outside(plot)
	return plot.frame * CFrame.new(0,3.65,36)
end

function Plots.liftDestination(plot,floor)
	return Factory.floorFrame(plot.frame,floor) * CFrame.new(-31.5,3.5,23)
end

local function addLift(plot, floor, callbacks)
	if plot.liftPads[floor] then return end
	local parent = plot.floors[floor]
	local frame = Factory.liftFrame(plot.frame,floor)
	local color = Color3.fromRGB(85,236,249)
	local landing = P.make("Model",parent,"Lift landing")
	P.part(landing,"Platform",Vector3.new(8.1,.25,5.2),frame * CFrame.new(-.8,-.11,0),P.Ink,Enum.Material.Metal,true)
	for _, x in ipairs({-4.6,3}) do
		P.part(landing,"Guide",Vector3.new(.35,11.7,.4),frame * CFrame.new(x,5.75,-2.61),color,Enum.Material.Neon)
	end
	local pads = {}
	for _, step in ipairs({-1,1}) do
		if floor + step >= 1 and floor + step <= #plot.floors then
			local pad = button(landing,frame * CFrame.new(-.8,0,step*1.69),"Lift",color,
				step > 0 and "Lift up" or "Lift down",step > 0 and "Лифт вверх" or "Лифт вниз",
				0,function(player, part) callbacks.lift(player,plot,part,floor+step) end)
			pad.Size = Vector3.new(3.6,.27,2.1)
			table.insert(pads,pad)
		end
	end
	plot.liftPads[floor] = {landing=landing,pads=pads}
end

local function refreshLift(plot,callbacks)
	if plot.profile.Stage < 51 then return end
	if #plot.floors == 4 and plot.liftPads[3] and #plot.liftPads[3].pads == 1 then
		plot.liftPads[3].landing:Destroy()
		plot.liftPads[3] = nil
	end
	for floor = 1,#plot.floors do addLift(plot,floor,callbacks) end
end

local function addFloor(plot, floor, callbacks)
	plot.floors[floor] = Factory.floor(plot.factory,plot.frame,floor)
	local cash = button(plot.floors[floor],Factory.collectFrame(plot.frame,floor),"Collect",blue,
		"Collect Cash","Забрать деньги",plot.owner.UserId,function(player,part)
			callbacks.collect(player,plot,part)
		end)
	cash:SetAttribute("PlotId",plot.id)
	local amount = P.billboard(cash,"Amount","$0",92,25,3.93,34)
	amount.TextColor3 = blue
	plot.collects[floor] = amount
end

function Plots.refresh(plot)
	local profile = plot.profile
	for _, label in ipairs(plot.collects) do label.Text = "$" .. fmt(profile.Chest) end
	for part, price in pairs(plot.prices) do
		local canBuy = profile.Cash >= price
		if part:GetAttribute("Affordable") ~= canBuy then
			part:SetAttribute("Affordable",canBuy)
			part.Color = canBuy and green or red
			local en = part:GetAttribute("LabelEN") .. (canBuy and "  ·  READY" or "  ·  NEED CASH")
			local ru = part:GetAttribute("LabelRU") .. (canBuy and "  ·  ДОСТУПНО" or "  ·  НЕ ХВАТАЕТ")
			local label = part.Title.Label
			label.Text = en
			P.translate(label,en,ru)
		end
	end
end

local function addCostumePad(plot,floor,callbacks)
	local spec = Costumes[floor]
	if plot.profile.Costumes[spec.id] or plot.costumePads[floor] then return end
	local price = Economy.CostumePrices[floor]
	local en = "Buy costume\n$" .. fmt(price,true)
	local ru = "Купить костюм\n$" .. fmt(price,true)
	local pad = button(plot.floors[floor],Factory.costumeFrame(plot.frame,floor),"Costume",violet,en,ru,plot.owner.UserId,
		function(player,part) callbacks.costume(player,plot,part,floor) end,price)
	plot.costumePads[floor] = pad
	plot.prices[pad] = price
end

local function nextPurchase(plot, callbacks)
	if plot.buyPad then
		plot.prices[plot.buyPad] = nil
		plot.buyPad:Destroy()
		plot.buyPad = nil
	end
	local upgrade = Economy.Upgrades[plot.profile.Stage+1]
	if not upgrade then return end
	local price = "\n$" .. fmt(upgrade.price,true)
	local pad = button(plot.floors[upgrade.floor],Factory.padFrame(plot.frame,upgrade),"Buy",green,
		upgrade.en .. price,upgrade.ru .. price,plot.owner.UserId,function(player,part)
			callbacks.upgrade(player,plot,part,upgrade)
		end,upgrade.price)
	pad:SetAttribute("UpgradeId",upgrade.id)
	pad:SetAttribute("PlotId",plot.id)
	plot.buyPad = pad
	plot.prices[pad] = upgrade.price
end

function Plots.setDoors(plot)
	if not plot.door then return end
	local closed = plot.profile.Settings.Doors
	plot.shell:SetAttribute("Closed",closed)
	plot.door.CFrame = plot.door:GetAttribute("BaseCFrame") * CFrame.new(closed and 0 or 9.18,0,0)
	plot.door.CanCollide = closed
	plot.door.CanQuery = closed
end

local function buildUpgrade(plot,upgrade,callbacks)
	local item = Factory.upgrade(plot.floors[upgrade.floor],plot.frame,upgrade)
	Dropper.bind(item,plot)
	item:SetAttribute("PlotId",plot.id)
	if upgrade.kind == "doors" then
		plot.door = item:FindFirstChild("SecurityGate")
		local pad = button(plot.floors[1],Factory.floorFrame(plot.frame,1) * CFrame.new(-5.7,.29,26),"Door",
			violet,"Toggle access","Открыть / закрыть",plot.owner.UserId,function(player,part)
				callbacks.door(player,plot,part)
			end)
		pad.Size = Vector3.new(3.75,.32,2.7)
		Plots.setDoors(plot)
	end
	return item
end

function Plots.claim(plot,player,profile,callbacks)
	plot.owner, plot.profile = player,profile
	plot.shell:SetAttribute("Owner",player.UserId)
	Plots.wayfinding()
	plot.title.Text = player.DisplayName
	P.translate(plot.title,player.DisplayName,player.DisplayName)
	plot.claim:Destroy()
	plot.claim = nil
	plot.factory = P.make("Model",plot.factories,"Factory" .. plot.id)
	plot.factory:SetAttribute("PlotId",plot.id)
	plot.floors,plot.prices,plot.collects,plot.costumePads,plot.liftPads = {},{},{},{},{}
	addFloor(plot,1,callbacks)
	for i=1,profile.Stage do
		local upgrade = Economy.Upgrades[i]
		buildUpgrade(plot,upgrade,callbacks)
		if i % 20 == 0 then
			addCostumePad(plot,upgrade.floor,callbacks)
			if upgrade.floor < 4 then addFloor(plot,upgrade.floor+1,callbacks) end
		end
	end
	refreshLift(plot,callbacks)
	nextPurchase(plot,callbacks)
	Plots.refresh(plot)
end

function Plots.upgrade(plot,upgrade,callbacks)
	local item = buildUpgrade(plot,upgrade,callbacks)
	if upgrade.order == 20 then
		addCostumePad(plot,upgrade.floor,callbacks)
		if upgrade.floor < 4 then addFloor(plot,upgrade.floor+1,callbacks) end
	end
	refreshLift(plot,callbacks)
	nextPurchase(plot,callbacks)
	Plots.refresh(plot)
	return item
end

function Plots.costumeBought(plot,floor)
	local pad = plot.costumePads[floor]
	if pad then
		plot.prices[pad] = nil
		pad:Destroy()
		plot.costumePads[floor] = nil
	end
	Plots.refresh(plot)
end

function Plots.release(plot, callbacks)
	plot.owner, plot.profile, plot.production = nil,nil,nil
	plot.shell:SetAttribute("Owner",0)
	Plots.wayfinding()
	plot.shell:SetAttribute("Closed",false)
	for floor = 1,4 do plot.shell:SetAttribute("LaneEpoch" .. floor,nil) end
	plot.title.Text = "FREE PLOT"
	P.translate(plot.title,"FREE PLOT","СВОБОДНЫЙ УЧАСТОК")
	plot.factory:Destroy()
	plot.factory, plot.buyPad, plot.door = nil,nil,nil
	plot.floors, plot.prices, plot.collects, plot.costumePads, plot.liftPads = nil,nil,nil,nil,nil
	claimPad(plot,callbacks)
end

return Plots
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Profile</string>
            <string name="Source"><![CDATA[local Profile = {}
Profile.Version = 2

local function number(value, default, limit)
	if type(value) == "number" and value == value then
		return math.floor(math.clamp(value, 0, limit))
	end
	return default
end

function Profile.read(raw, economy, gameConfig, costumes, fallbackLanguage)
	local empty = raw == nil
	if not empty and type(raw) ~= "table" then return nil end
	raw = raw or {}
	local version = raw.Version or 1
	if version ~= 1 and version ~= Profile.Version then return nil end
	local profile = {
		Cash = number(raw.Cash, raw.Cash == nil and gameConfig.StartCash or 0, gameConfig.MaxCash),
		Chest = number(raw.Chest, 0, gameConfig.MaxCash),
		Tutorial = number(raw.Tutorial, 0, 5),
		Stage = 0,
		Costumes = {},
		Equipped = "",
		Settings = { Language = fallbackLanguage, Music = true, Sound = true, Doors = false },
	}
	if type(raw.Purchased) == "table" then
		local owned = {}
		for key, value in pairs(raw.Purchased) do
			if type(value) == "string" then owned[value] = true end
			if type(key) == "string" and value == true then owned[key] = true end
		end
		for i, upgrade in ipairs(economy.Upgrades) do
			if not owned[upgrade.id] then break end
			profile.Stage = i
		end
	elseif version == 1 then
		profile.Stage = number(raw.Stage, 0, #economy.Upgrades)
	end
	if profile.Stage >= 2 then profile.Tutorial = 5 end
	if type(raw.Costumes) == "table" then
		for _, costume in ipairs(costumes) do
			if raw.Costumes[costume.id] == true or table.find(raw.Costumes, costume.id) then
				profile.Costumes[costume.id] = true
			end
		end
	end
	if type(raw.Equipped) == "string" and profile.Costumes[raw.Equipped] then
		profile.Equipped = raw.Equipped
	end
	if type(raw.Settings) == "table" then
		local source = raw.Settings
		for _, key in ipairs({"Music", "Sound", "Doors"}) do
			if type(source[key]) == "boolean" then profile.Settings[key] = source[key] end
		end
		if source.Language == "en" or source.Language == "ru" then profile.Settings.Language = source.Language end
	end
	return profile
end

function Profile.snapshot(profile, economy)
	local purchases = table.create(profile.Stage)
	for i = 1, profile.Stage do purchases[i] = economy.Upgrades[i].id end
	return {
		Version = Profile.Version, Cash = profile.Cash, Chest = profile.Chest,
		Purchased = purchases, UnlockedFloors = economy.floorFor(profile.Stage),
		Costumes = table.clone(profile.Costumes), Equipped = profile.Equipped,
		Settings = table.clone(profile.Settings), Tutorial = profile.Tutorial,
	}
end

return Profile
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">PurchaseService</string>
            <string name="Source"><![CDATA[local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Brainrot")
local Costumes = require(Shared.CostumeConfig)
local Economy = require(script.Parent.EconomyService)
local Tutorial = require(script.Parent.TutorialService)
local Purchase = {}

function Purchase.upgrade(plot,spec,now)
	-- Settle production under the current rate before applying the new one.
	if Economy.produce(plot,now) > 0 then Tutorial.advance(plot.profile,3) end
	local ok, reason = Economy.buyUpgrade(plot.profile,spec)
	if not ok then return false,reason end
	Economy.syncLanes(plot,now)
	if spec.index == 1 then Tutorial.advance(plot.profile,2) end
	if spec.index == 2 then Tutorial.advance(plot.profile,5) end
	return true
end

function Purchase.costume(plot,floor)
	local costume = Costumes[floor]
	if not costume then return false,"locked" end
	return Economy.buyCostume(plot.profile,floor,costume)
end

return Purchase
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">TutorialService</string>
            <string name="Source"><![CDATA[local Tutorial = {}

function Tutorial.advance(profile, milestone)
	-- Monotonic even if a returning player skips an early prompt.
	if milestone == 5 or milestone == profile.Tutorial + 1 then
		profile.Tutorial = math.max(profile.Tutorial, milestone)
	end
end

return Tutorial
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">TycoonService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Brainrot")

local Game = require(Shared.GameConfig)
local Config = require(Shared.EconomyConfig)
local Costumes = require(Shared.CostumeConfig)
local Data = require(script.Parent.DataService)
local Economy = require(script.Parent.EconomyService)
local Plot = require(script.Parent.PlotService)
local Purchase = require(script.Parent.PurchaseService)
local Collector = require(script.Parent.CollectorService)
local Conveyor = require(script.Parent.ConveyorService)
local Costume = require(script.Parent.CostumeService)
local Tutorial = require(script.Parent.TutorialService)
local Leaderboard = require(script.Parent.LeaderboardService)
local Tycoon = {}

local owned, active, limiters = {}, {}, {}
local callbacks = {}
local plots, spawn, board, events
local closing = false

local function now()
	return workspace:GetServerTimeNow()
end

local function send(player,kind,value)
	events.Feedback:FireClient(player,kind,value)
end

local function admit(player,action,interval)
	local slots = limiters[player]
	if not slots then return false end
	local time = os.clock()
	if time < (slots[action] or 0) then return false end
	slots[action] = time + interval
	return true
end

local function rootOf(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if root and humanoid and humanoid.Health > 0 then return root, character end
end

local function near(player, pad)
	local root = rootOf(player)
	return closing == false and pad.Parent ~= nil and root ~= nil and
		(root.Position - pad.Position).Magnitude <= Game.PromptDistance + 2.25
end

local function owns(player,plot)
	return plot.owner == player and owned[player] == plot and Data.get(player) == plot.profile
end

local function sync(player,profile)
	if not profile then return end
	local plot = owned[player]
	player:SetAttribute("Cash",profile.Cash)
	player:SetAttribute("Chest",profile.Chest)
	player:SetAttribute("Rate",Config.Stages[profile.Stage].rate)
	player:SetAttribute("Stage",profile.Stage)
	player:SetAttribute("Floor",Config.floorFor(profile.Stage))
	player:SetAttribute("PlotId",plot and plot.id or 0)
	player:SetAttribute("Tutorial",profile.Tutorial)
	player:SetAttribute("CostumesMask",Costume.mask(profile))
	player:SetAttribute("Equipped",profile.Equipped)
	for key, value in pairs(profile.Settings) do player:SetAttribute(key,value) end
	Leaderboard.sync(player,profile)
	if plot then Plot.refresh(plot) end
end

local function relay(plot,kind,position,value)
	for _, listener in ipairs(Players:GetPlayers()) do
		local root = rootOf(listener)
		if root and (root.Position-position).Magnitude < 135 then
			events.WorldFX:FireClient(listener,kind,position,plot.id,value)
		end
	end
end

function callbacks.claim(player,plot,pad)
	if not near(player,pad) or not admit(player,"prompt",.32) or owned[player] or plot.owner or plot.claim ~= pad then return end
	local profile = Data.get(player)
	if not profile then return end
	Tutorial.advance(profile,1)
	-- Ownership, transactions and build state change in one non-yielding server turn.
	owned[player] = plot
	Plot.claim(plot,player,profile,callbacks)
	Economy.attach(plot,now())
	sync(player,profile)
	send(player,"claimed")
end

function callbacks.collect(player,plot,pad)
	if not near(player,pad) or not owns(player,plot) or not admit(player,"prompt",.26) then return end
	local amount = Collector.collect(plot,now())
	sync(player,plot.profile)
	if amount > 0 then
		send(player,"collected",amount)
		relay(plot,"collect",pad.Position,amount)
	else
		send(player,"empty")
	end
end

function callbacks.upgrade(player,plot,pad,spec)
	if not near(player,pad) or plot.buyPad ~= pad or not owns(player,plot) or not admit(player,"prompt",.25) then return end
	local position = pad.Position
	local ok, reason = Purchase.upgrade(plot,spec,now())
	if not ok then
		sync(player,plot.profile)
		send(player,reason)
		return
	end
	Plot.upgrade(plot,spec,callbacks)
	sync(player,plot.profile)
	relay(plot,"build",position,spec.id)
	if spec.index == #Config.Upgrades then
		send(player,"completed")
	elseif spec.order == 20 then
		send(player,"floor",spec.floor+1)
	else
		send(player,"upgrade",spec.id)
	end
end

function callbacks.costume(player,plot,pad,floor)
	if not near(player,pad) or plot.costumePads[floor] ~= pad or not owns(player,plot) or not admit(player,"prompt",.25) then return end
	local position = pad.Position
	local ok, reason = Purchase.costume(plot,floor)
	if not ok then send(player,reason) return end
	Plot.costumeBought(plot,floor)
	sync(player,plot.profile)
	send(player,"costume",Costumes[floor].id)
	relay(plot,"unlock",position,floor)
end

local function access(player,plot)
	plot.profile.Settings.Doors = not plot.profile.Settings.Doors
	Plot.setDoors(plot)
	sync(player,plot.profile)
	send(player,plot.profile.Settings.Doors and "closed" or "open")
end

function callbacks.door(player,plot,pad)
	if not near(player,pad) or not plot.door or not owns(player,plot) or not admit(player,"prompt",.4) then return end
	access(player,plot)
end

function callbacks.lift(player,plot,pad,floor)
	if not near(player,pad) or not plot.owner or not plot.floors[floor] or not Data.get(player)
		or not admit(player,"lift",.85) or (plot.profile.Settings.Doors and plot.owner ~= player) then return end
	local _, character = rootOf(player)
	if character then
		character:PivotTo(Plot.liftDestination(plot,floor))
		send(player,"lift")
	end
end

local function watchBorders()
	local since = 0
	RunService.Heartbeat:Connect(function(dt)
		since += dt
		if since < .3 then return end
		since = 0
		local players = Players:GetPlayers()
		for _, plot in ipairs(plots) do
			if plot.door and plot.profile.Settings.Doors then
				for _, player in ipairs(players) do
					if player ~= plot.owner then
						local root, character = rootOf(player)
						if root then
							local p = plot.frame:PointToObjectSpace(root.Position)
							if math.abs(p.X) < 42.9 and math.abs(p.Z) < 29.1 and p.Y > -4 and p.Y < 68 then
								character:PivotTo(Plot.outside(plot))
							end
						end
					end
				end
			end
		end
	end)
end

local function request(player,action,arg)
	if closing or type(action) ~= "string" or #action > 20 or not admit(player,"remote",.16) then return end
	local profile = Data.get(player)
	if not profile then return end
	local plot = owned[player]
	if action == "language" and (arg == "en" or arg == "ru") then
		profile.Settings.Language = arg
	elseif action == "music" and type(arg) == "boolean" then
		profile.Settings.Music = arg
	elseif action == "sound" and type(arg) == "boolean" then
		profile.Settings.Sound = arg
	elseif action == "equip" and type(arg) == "string" and #arg < 20 and Costume.valid(profile,arg) then
		profile.Equipped = arg
		Costume.apply(player.Character,arg)
		send(player,arg == "" and "unequipped" or "equipped")
	elseif action == "doors" and arg == nil and plot and plot.door and admit(player,"doors",.5) then
		access(player,plot)
		return
	elseif action == "teleport" and arg == nil and admit(player,"teleport",3) then
		if not plot then send(player,"noPlot") return end
		local root, character = rootOf(player)
		if not root then return end
		local target = Plot.entry(plot)
		if (root.Position-target.Position).Magnitude > 100 then
			pcall(player.RequestStreamAroundAsync,player,target.Position,2)
		end
		local _, current = rootOf(player)
		if not closing and owned[player] == plot and Data.get(player) == profile and current == character then
			character:PivotTo(target)
			send(player,"teleported")
		end
		return
	else
		return
	end
	sync(player,profile)
end

local function disconnect(player)
	active[player] = nil
	local plot = owned[player]
	if plot then
		if Data.get(player) then Economy.produce(plot,now()) end
		owned[player] = nil
		Plot.release(plot,callbacks)
	end
	limiters[player] = nil
end

local function leave(player)
	disconnect(player)
	Data.release(player)
end

local function joined(player)
	if active[player] or closing then return end
	local count = 0
	for _ in pairs(active) do count += 1 end
	if count >= Game.MaxPlayers then
		player:Kick("This factory district is full (8 players).")
		return
	end
	active[player] = "loading"
	player.RespawnLocation = spawn
	limiters[player] = {}
	player:SetAttribute("PlotId",0)
	local function reapply(character)
		local profile = Data.get(player)
		if profile and player.Character == character then Costume.apply(character,profile.Equipped) end
	end
	player.CharacterAdded:Connect(function(character)
		if character:WaitForChild("Head",8) then reapply(character) end
	end)
	player.CharacterAppearanceLoaded:Connect(reapply)
	local profile, errorCode = Data.acquire(player)
	if player.Parent ~= Players or closing or not active[player] then
		Data.release(player)
		return
	end
	if not profile then
		active[player] = nil
		local ru = string.sub(string.lower(player.LocaleId),1,2) == "ru"
		local busy = ru and "Сохранение открыто на другом сервере. Войдите чуть позже." or "Your save is active on another server. Rejoin shortly."
		local failed = ru and "Не удалось безопасно загрузить прогресс. Попробуйте войти позже." or "Your factory save could not be loaded safely. Please rejoin later."
		player:Kick(errorCode == "busy" and busy or failed)
		return
	end
	active[player] = "ready"
	reapply(player.Character)
	sync(player,profile)
	player:SetAttribute("Ready",true)
end

function Tycoon.start(network)
	events = network
	plots, spawn, board = Plot.create(callbacks)
	Leaderboard.start(board)
	Conveyor.start(plots,function(plot) sync(plot.owner,plot.profile) end)
	watchBorders()
	network.Action.OnServerEvent:Connect(request)
	Players.PlayerAdded:Connect(joined)
	Players.PlayerRemoving:Connect(leave)
	for _, player in ipairs(Players:GetPlayers()) do task.spawn(joined,player) end
	task.spawn(function()
		local age = 0
		while not closing do
			task.wait(5)
			if closing then break end
			age += 5
			for player,state in pairs(active) do
				if state == "ready" and not Data.get(player) then
					disconnect(player)
					task.spawn(Data.release,player)
					player:Kick("The save session is unavailable. Please rejoin. / Сессия сохранения недоступна. Войдите снова.")
				end
			end
			if age >= Game.SaveEvery then Data.maintain(false) age = 0 end
		end
	end)
	game:BindToClose(function()
		closing = true
		for _, player in ipairs(Players:GetPlayers()) do disconnect(player) end
		local untilTime = os.clock() + 25
		while Data.hasSessions() and os.clock() < untilTime do
			Data.maintain(true)
			task.wait(.5)
		end
	end)
end

return Tycoon
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="30">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder" referent="31">
      <Properties>
        <string name="Name">FactoryAssets</string>
      </Properties>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">CostumeBuilder</string>
          <string name="Source"><![CDATA[local P = require(script.Parent.Parts)
local C = {}
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local dark = rgb(23, 31, 48)
local white = rgb(253, 251, 240)
local gold = rgb(255, 209, 96)
local pink = rgb(255, 149, 180)
local ball, block, cylinder = Enum.PartType.Ball, Enum.PartType.Block, Enum.PartType.Cylinder
local standing = CFrame.Angles(0, 0, math.pi / 2)
local origins = {
	head = CFrame.new(0, 1.94, 0), torso = CFrame.new(0, 0.47, 0),
	leftArm = CFrame.new(-1.45, 0.48, 0), rightArm = CFrame.new(1.45, 0.48, 0),
	leftLeg = CFrame.new(-0.52, -1.22, 0), rightLeg = CFrame.new(0.52, -1.22, 0),
	leftHand = CFrame.new(-1.45,-.46,0), rightHand = CFrame.new(1.45,-.46,0),
	leftFoot = CFrame.new(-.52,-2.03,0), rightFoot = CFrame.new(.52,-2.03,0),
}
local anchors = {
	head = {"Head"}, torso = {"UpperTorso", "Torso"},
	leftArm = {"RightUpperArm", "Right Arm"}, rightArm = {"LeftUpperArm", "Left Arm"},
	leftLeg = {"RightUpperLeg", "Right Leg"}, rightLeg = {"LeftUpperLeg", "Left Leg"},
	leftHand = {"RightHand","Right Arm"}, rightHand = {"LeftHand","Left Arm"},
	leftFoot = {"RightFoot","Right Leg"}, rightFoot = {"LeftFoot","Left Leg"},
}
local legacyOffset = {
	leftHand=CFrame.new(0,-.94,0), rightHand=CFrame.new(0,-.94,0),
	leftFoot=CFrame.new(0,-.81,0), rightFoot=CFrame.new(0,-.81,0),
}
-- Display coordinates use the camera-facing left and right. Avatar welds use anatomical names.
local function create(model, id, resolve)
	local function piece(bone, label, size, x, y, z, color, shape, rotation, material)
		local base, limb, adjust = resolve(bone)
		if not base then return end
		local offset = (adjust or CFrame.identity) * CFrame.new(x, y, z) * (rotation or CFrame.identity)
		local part = P.part(model, label, Vector3.new(table.unpack(size)), base * offset, color, material, false, shape)
		if limb then
			part.Massless = true
			local weld = Instance.new("Weld")
			weld.Part0, weld.Part1, weld.C0 = limb, part, offset
			weld.Parent = part
			part.Anchored = false
		end
	end
	local function face(separation, y, z, eyeColor)
		for _, side in ipairs({-1, 1}) do
			piece("head", "Eye", {.43,.52,.19}, separation * side, y, z, white, ball)
			piece("head", "Pupil", {.2,.3,.11}, separation * side + .035, y - .02, z - .08, eyeColor or dark, ball)
		end
	end
	local function limbs(arm, pants, shoe)
		for _, side in ipairs({"left","right"}) do
			piece(side .. "Arm", "Sleeve", {.87,1.32,.91},0,-.28,0,arm,ball)
			piece(side .. "Hand", "Glove", {.69,.61,.72},0,0,-.03,shoe,ball)
			piece(side .. "Leg", "Leg", {.92,1.36,.93},0,-.24,0,pants,ball)
			local f = side .. "Foot"
			piece(f, "Boot sole", {1.03,.31,1.55},0,-.19,-.25,white,block)
			piece(f, "Boot", {1.01,.64,1.46},0,.08,-.25,shoe,ball)
			piece(f, "Lace", {.66,.08,.26},0,.34,-.43,white,block)
		end
	end
	if id == "sahur" then
		local brown, honey = rgb(149, 84, 53), rgb(225, 151, 79)
		piece("torso", "Wooden shell", {1.65,2.21,1.54},0,0,0,brown,cylinder,standing)
		piece("head", "Carved head", {1.69,1.93,1.59},0,.07,0,honey,cylinder,standing)
		for i = -2, 2 do
			piece("head", "Wood inlay", {.10,1.4,.1}, i * .31,.05,-.74 + math.abs(i)*.07,brown,block)
		end
		piece("head", "Growth ring", {.14,1.44,1.33},0,.98,0,rgb(244,188,114),cylinder,standing)
		piece("head", "Rounded nose", {.39,.37,.47},0,-.16,-.96,brown,ball)
		piece("head", "Smile", {.48,.18,.12},0,-.44,-.82,dark,ball)
		piece("torso", "Yellow strap", {.43,1.54,.14},0,.1,-.78,gold,block,CFrame.Angles(0,0,-.48))
		piece("torso", "Belt clamp", {.23,2.31,1.65},0,-.56,0,dark,cylinder,standing)
		face(.43,.29,-.86)
		limbs(brown, honey, dark)
	elseif id == "tralala" then
		local blue, navy = rgb(66, 161, 218), rgb(35, 76, 142)
		piece("torso", "Shark body", {2.36,2.12,1.75},0,.02,0,blue,ball)
		piece("torso", "Belly", {1.69,1.6,.63},0,-.07,-.61,white,ball)
		piece("torso", "Dorsal fin", {.35,1.32,1.09},0,.62,.76,navy,ball,CFrame.Angles(.55,0,0))
		piece("torso", "Tail", {.64,.61,1.52},0,-.43,1.04,blue,ball,CFrame.Angles(.32,0,0))
		piece("torso", "Tail fin", {1.51,.23,.74},0,-.17,1.69,navy,ball)
		piece("head", "Shark hood", {2.28,1.85,2.18},0,.08,0,blue,ball)
		piece("head", "Rounded muzzle", {1.87,.74,.95},0,-.39,-.73,white,ball)
		piece("head", "Grin", {1.26,.3,.16},0,-.44,-1.15,navy,ball)
		for i = -2, 2 do piece("head", "Tooth", {.12,.13,.08},i*.19,-.41,-1.226,white,block) end
		face(.57,.23,-.98)
		limbs(blue, navy, rgb(48, 117, 246))
	elseif id == "patapim" then
		local moss, leaf, bark = rgb(98, 156, 75), rgb(157, 202, 91), rgb(116, 84, 64)
		piece("torso", "Forest coat", {2.29,2.18,1.73},0,.02,0,moss,ball)
		piece("torso", "Bark bib", {1.46,1.6,.58},0,-.06,-.66,bark,ball)
		piece("head", "Moss cap", {2.25,1.99,1.81},0,.13,0,moss,ball)
		for i = -2, 2 do
			piece("head", "Leaf tuft", {.68,.46,.85}, i * .38,.86 + (2 - math.abs(i)) * .09,-.1,leaf,ball,CFrame.Angles(0,i*.19,i*.22))
		end
		piece("head", "Leaf stem", {.15,.71,.18},.27,1.1,-.03,bark,ball,CFrame.Angles(0,0,-.35))
		piece("head", "Long nose", {.46,.43,1.08},0,-.14,-.94,rgb(216, 148, 95),ball,CFrame.Angles(-.34,0,0))
		piece("head", "Smile", {.62,.19,.17},0,-.5,-.79,dark,ball)
		face(.48,.29,-.83)
		limbs(moss, bark, leaf)
	elseif id == "saturnita" then
		local plum = rgb(94, 64, 160)
		piece("torso", "Space suit", {2.31,2.19,1.88},0,.03,0,white,ball)
		piece("torso", "Cow patch", {.83,.93,.33},-.58,.33,-.79,plum,ball,CFrame.Angles(0,0,.36))
		piece("torso", "Suit controls", {.67,.58,.27},.34,-.08,-.91,plum,block)
		for i = 1, 14 do
			local angle = i * math.pi / 7
			local orbit = CFrame.Angles(0,0,.24) * CFrame.new(math.cos(angle)*1.87,-.23,math.sin(angle)*1.87)
			piece("torso", "Orbit segment", {.57,.11,.43},orbit.X,orbit.Y,orbit.Z,i % 3 == 0 and gold or pink,ball,nil,Enum.Material.Neon)
		end
		piece("head", "Cow helmet", {2.27,1.77,1.82},0,.14,0,white,ball)
		piece("head", "Muzzle", {1.6,.67,.75},0,-.32,-.83,pink,ball)
		for _, side in ipairs({-1,1}) do
			piece("head", "Nostril", {.19,.12,.1},side*.31,-.27,-1.19,plum,ball)
			piece("head", "Satellite ear", {.7,.37,.46},side*1.03,.43,0,pink,ball,CFrame.Angles(0,0,side*.36))
			piece("head", "Horn", {.38,.73,.41},side*.68,.94,-.04,gold,ball,CFrame.Angles(0,0,-side*.24))
		end
		face(.51,.33,-.86,plum)
		limbs(white, plum, pink)
	end
end

function C.display(parent, id, frame)
	local model = P.make("Model", parent, "Display_" .. id)
	create(model, id, function(bone)
		return frame * origins[bone]
	end)
	return model
end

function C.wear(character, id)
	local model = P.make("Model", character, "FactoryCostume")
	create(model, id, function(bone)
		for index, name in ipairs(anchors[bone]) do
			local limb = character:FindFirstChild(name)
			if limb and limb:IsA("BasePart") then return limb.CFrame, limb, index == 2 and legacyOffset[bone] or nil end
		end
	end)
	return model
end

return C
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">FactoryBuilder</string>
          <string name="Source"><![CDATA[local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Brainrot")
local CollectionService = game:GetService("CollectionService")
local Floors = require(Shared.FloorConfig)
local Costumes = require(Shared.CostumeConfig)
local P = require(script.Parent.Parts)
local CostumeBuilder = require(script.Parent.CostumeBuilder)
local F = {}

local rgb = Color3.fromRGB
local ink, white = P.Ink, P.White
local metal, neon = Enum.Material.Metal, Enum.Material.Neon
local gold = rgb(255, 206, 86)
local dark = rgb(37, 48, 66)
local concrete = rgb(119, 146, 155)
local slots = {
	A={-29,-19}, B={-18,-19}, C={-7,-19}, D={4,-19}, E={15,-19}, F={26,-19},
	G={-29,4}, H={-18,4}, I={-7,4}, J={4,4}, K={15,4}, L={26,4},
}
local featurePads = {
	walls={-18,20}, chest={31,-1}, lights={-8,19}, doors={11,24},
	stairs={36,17}, lift={-29,17}, pipes={-34,-24}, roof={3,18}, sign={18,19},
}
local floorInk = {rgb(56,84,91), rgb(80,70,69), rgb(45,73,98), rgb(62,49,94)}

local function at(parent, frame, name, x, y, z, sx, sy, sz, color, material, solid, shape, rotation)
	return P.part(parent, name, Vector3.new(sx, sy, sz), frame * CFrame.new(x,y,z) * (rotation or CFrame.identity), color, material, solid, shape)
end

local function ring(parent, frame, x, y, z, rx, ry, color, vertical)
	for i = 1, 10 do
		local angle = i * math.pi / 5
		local dx, offset = math.cos(angle) * rx, math.sin(angle) * ry
		at(parent, frame, "Ring segment", x+dx, y+(vertical and offset or 0), z+(vertical and 0 or offset),
			1.28, .55, .55, color, neon, false, nil,
			vertical and CFrame.Angles(0,0,angle+math.pi/2) or CFrame.Angles(0,-angle+math.pi/2,0))
	end
end

local function lane(parent, frame, floor, kind)
	local palette = Floors.Names[floor]
	local second = kind == "doublebelt"
	local z = second and -3.6 or -8
	local color = kind == "belt" and gold or palette.color
	at(parent,frame,"Conveyor bed",-1.9,1.1,z,59.8,.58,3.8,ink,metal)
	at(parent,frame,"Rubber belt",-1.9,1.45,z,59.8,.18,2.9,floorInk[floor],Enum.Material.Rubber)
	for _, dz in ipairs({-1.78,1.78}) do
		at(parent,frame,"Conveyor rail",-1.9,1.56,z+dz,59.8,.25,.19,color,neon)
	end
	for x = -28, 24, 7 do
		at(parent,frame,"Roller",x,1.58,z,.26,.11,2.66,white)
		if x % 2 == 0 then at(parent,frame,"Conveyor foot",x,.43,z,.59,.86,3.65,ink,metal) end
	end
end

local function vault(parent, frame, floor, tier)
	local palette = Floors.Names[floor]
	local trim = tier == 1 and palette.color or tier == 2 and gold or white
	if tier == 1 then
		at(parent,frame,"Chest base",31,.32,-8,6.4,.64,5.3,ink,metal)
		at(parent,frame,"Chest body",31,1.4,-8,6.0,1.75,4.9,palette.body,metal)
		at(parent,frame,"Chest lid",31,2.48,-8,6.2,.48,5.1,dark,metal)
	else
		local y = 2.64 + (tier - 2) * .42
		at(parent,frame,"Reinforcement",31,y,-8,6.35,.31,5.19,trim,metal)
		at(parent,frame,"Level indicator",31,y,-5.36,3.4,.19,.11,trim,neon)
		return
	end
	at(parent,frame,"Chest inlet",27.97,1.69,-8,.13,1.05,2.72,trim,neon)
	at(parent,frame,"Vault latch",31,1.75,-5.47,1.2,.95,.25,trim,metal)
end

function F.floorFrame(plotFrame, floor)
	return plotFrame * CFrame.new(0, .65 + (floor - 1) * Floors.Height, 0)
end

function F.floor(parent, plotFrame, floor)
	local frame = F.floorFrame(plotFrame, floor)
	local palette = Floors.Names[floor]
	local m = P.make("Model", parent, string.format("Floor%02d",floor))
	local shell = P.make("Model", m, "Deck")
	local function deck(name,x,z,sx,sz)
		at(shell, frame, name, x,-.24,z,sx,.48,sz,floorInk[floor],metal,true)
	end
	if floor == 1 then
		deck("Foundation slab",0,0,85,59)
	else
		deck("Main slab",-4.9,0,75.2,59)
		deck("Rear stair landing",37.6,-21.3,9.8,16.4)
		deck("Front stair landing",37.6,21.0,9.8,17)
	end
	for _, z in ipairs({-28.8,28.8}) do
		at(shell,frame,"Deck edge",0,-.03,z,84.3,.17,.41,palette.color,neon)
	end
	for _, z in ipairs({-25.4,12.7}) do
		at(shell,frame,"Walkway stripe",-1,.015,z,66,.045,.16,palette.color)
	end
	for i = -4,4 do
		local arrow = at(shell,frame,"Entry stripes",i*1.28,.035,27.65,.6,.035,1.4,gold,nil,false,nil,CFrame.Angles(0,.30,0))
		arrow.Transparency = .15
	end
	for _, x in ipairs({-41,41}) do
		at(shell,frame,"Corner post",x,3.35,-27.85,.8,6.7,.85,ink,metal,true)
		at(shell,frame,"Corner post",x,3.35,27.85,.8,6.7,.85,ink,metal,true)
	end
	local sign = at(shell,frame,"Floor identity",-13,5.1,27.9,18,1.65,.36,ink)
	P.translate(P.surface(sign,"Title",palette.en,nil,palette.color), palette.en, palette.ru)
	local back = P.surface(sign,"Inside title",palette.en,Enum.NormalId.Front,palette.color)
	P.translate(back,palette.en,palette.ru)
	local pedestal = at(m,frame,"Costume plinth",28.5,.38,21,7.5,.77,6.8,ink,metal,true)
	at(m,frame,"Display underglow",28.5,.83,21,7.3,.17,6.6,Costumes[floor].tint,neon)
	at(m,frame,"Display rear",28.5,3.1,18.4,6.5,5,.18,palette.body,metal)
	local name = P.billboard(pedestal,"Costume name",Costumes[floor].name,144,29,6.9,40)
	P.translate(name,Costumes[floor].name,Costumes[floor].ru)
	CostumeBuilder.display(m, Costumes[floor].id, frame * CFrame.new(28.5,3.07,21) * CFrame.Angles(0,math.pi,0))
	return m
end

local function wall(parent, frame, floor)
	local p = Floors.Names[floor]
	local bodyY = floor == 4 and 2 or 3.65
	local function panel(x,z,width,rotation)
		local section = frame * CFrame.new(x,0,z) * CFrame.Angles(0,rotation,0)
		at(parent,section,"Wall plinth",0,bodyY*.5,0,width,bodyY,.78,p.body,metal,true)
		local glass = at(parent,section,"Glazing",0,bodyY+(10.8-bodyY)*.5,0,width,10.8-bodyY,.44,rgb(116,199,238),Enum.Material.Glass,true)
		glass.Transparency = floor == 4 and .57 or .34
		at(parent,section,"Window header",0,11.16,0,width,.77,.64,ink,metal,true)
		at(parent,section,"Facade trim",0,10.88,.49,width,.19,.15,p.color,neon)
		for i = 1, math.floor(width/10) do
			local offset = (i/(math.floor(width/10)+1)-.5)*width
			at(parent,section,"Window mullion",offset,(10.8+bodyY)*.5,0,.28,10.8-bodyY,.61,ink,metal)
		end
	end
	panel(0,-28.3,84,0)
	panel(-41.8,0,56.2,math.pi/2)
	panel(41.8,0,56.2,math.pi/2)
	panel(-23.5,28.3,37,0)
	panel(23.5,28.3,37,0)
	at(parent,frame,"Entrance lintel",0,9.15,28.3,10.2,1.25,1.02,ink,metal,true)
end

local function stairs(parent, frame, color)
	local n, length = 19, 24.8
	for i = 1, n do
		local height = i * Floors.Height / n
		local z = 12.15 - (i-.5) * length / n
		at(parent,frame,"Step",37.5,height-.42,z,7.6,.84,length/n+.06,ink,metal,true)
		at(parent,frame,"Step tread",37.5,height+.02,z+.52,7.45,.06,.22,color,neon)
	end
	for _, x in ipairs({33.47,41.6}) do
		local rail = CFrame.Angles(math.atan(Floors.Height/length),0,0)
		at(parent,frame,"Handrail",x,9.22,-.25,.27,.28,math.sqrt(length^2+Floors.Height^2),color,metal,false,nil,rail)
		for i = 1, 4 do
			local fraction = i/5
			at(parent,frame,"Railing post",x,1.2+fraction*Floors.Height,12.15-fraction*length,.19,2.15,.2,ink,metal)
		end
	end
end

local machineKinds = {
	starter="dropper", dropper="dropper", gold="dropper", dual="dropper", mega="dropper",
	calibrator="console", boost="console", final="console", holo="console", loader="arm",
	arm="arm", press="press", furnace="furnace", plasma="core", super="core", core="core",
	quantum="core", void="core", reactor="core", crystal="crystal", rainbow="crystal",
	laser="laser", rail="laser", portal="portal", turbine="turbine",
}
local function machine(parent, frame, floor, kind, x, z)
	local palette = Floors.Names[floor]
	local accent = kind == "gold" and gold or kind == "void" and rgb(212,106,248) or palette.color
	local body = kind == "gold" and rgb(186,133,53) or palette.body
	local style = machineKinds[kind]
	at(parent,frame,"Machine plinth",x,.2,z,7.3,.4,6.8,ink,metal,true)
	at(parent,frame,"Machine housing",x,.69,z,6.65,.61,6.23,body,metal)
	at(parent,frame,"Identification stripe",x,.95,z+3.19,5.9,.23,.2,accent,neon)
	if style == "dropper" then
		local height = kind == "mega" and 5.4 or 3.4
		at(parent,frame,"Generator column",x,1+height/2,z,3.6,height,3.45,body,metal,true)
		at(parent,frame,"Generator cap",x,1+height,z,4.5,.49,4.25,ink,metal)
		for _, dx in ipairs(kind == "dual" and {-1.72,1.72} or {0}) do
			at(parent,frame,"Generator gauge",x+dx,2.36,z+1.77,.76,1.23,.16,accent,neon)
			at(parent,frame,"Feed arm",x+dx,1+height,(z-8)/2,1.08,.58,math.abs(z+8),body,metal)
			at(parent,frame,"Dispense nozzle",x+dx,1+height,-8,1.43,.78,1.2,accent,metal)
		end
	elseif style == "arm" then
		at(parent,frame,"Servo turret",x,1.25,z,1.05,3.6,3.6,body,metal,true,Enum.PartType.Cylinder,CFrame.Angles(0,0,math.pi/2))
		at(parent,frame,"Arm link",x-.52,2.48,z,.71,2.83,.79,accent,metal,false,nil,CFrame.Angles(0,0,-.5))
		at(parent,frame,"Arm link",x+.56,3.7,z,2.9,.68,.78,body,metal)
		for _, dx in ipairs({1.55,2.22}) do at(parent,frame,"Gripper",x+dx,3.14,z,.2,.62,.45,white,metal) end
	elseif style == "press" then
		for _, dx in ipairs({-2.05,2.05}) do at(parent,frame,"Press post",x+dx,3,z,.55,4,.67,body,metal,true) end
		at(parent,frame,"Press head",x,4.58,z,5.1,.73,3.0,ink,metal)
		at(parent,frame,"Press piston",x,2.97,z,1.4,2.6,1.6,accent,metal)
		at(parent,frame,"Press plate",x,1.78,z,3.55,.38,2.61,white,metal)
	elseif style == "furnace" then
		at(parent,frame,"Furnace chamber",x,2.48,z,5.35,3.4,4.9,body,metal,true)
		at(parent,frame,"Heat opening",x,2.25,z+2.49,3.7,1.68,.19,accent,neon)
		at(parent,frame,"Furnace chimney",x+1.45,4.49,z-.76,1.35,2.86,1.35,ink,metal)
		for i = -2,2 do at(parent,frame,"Heat grille",x+i*.58,2.25,z+2.65,.19,1.7,.18,ink,metal) end
	elseif style == "core" or style == "crystal" or style == "turbine" then
		local energyColor = kind == "void" and rgb(60,17,110) or accent
		local form = style == "crystal" and Enum.PartType.Block or Enum.PartType.Ball
		local formSize = style == "crystal" and Vector3.new(1.7,1.7,1.7) or Vector3.new(2.59,2.35,2.59)
		local orb = P.part(parent,"Production core",formSize,frame*CFrame.new(x,3.24,z)*CFrame.Angles(.56,0,.68),energyColor,neon,false,form)
		ring(parent,frame,x,3.25,z,2.38,2.09,accent,style ~= "turbine")
		for _, dx in ipairs({-2.45,2.45}) do
			at(parent,frame,"Reactor strut",x+dx,2.03,z,.47,2.45,.62,body,metal)
		end
		if kind == "reactor" then
			ring(parent,frame,x,4.87,z,2.69,2.35,gold,false)
			at(parent,frame,"Brainrot capacitor",x,5.33,z,2.3,1.0,2.18,white,neon,false,Enum.PartType.Ball)
			P.light(orb,accent,12,1.25)
		elseif kind == "rainbow" then
			for i = 1, 6 do
				at(parent,frame,"Prism",x-2.44+i*.71,1.64,z+2.53,.38,1.26,.31,Color3.fromHSV(i/6,.75,1),neon)
			end
		end
	elseif style == "portal" then
		ring(parent,frame,x,3.31,z,2.32,2.36,accent,true)
		local field = at(parent,frame,"Portal field",x,3.31,z,.29,3.67,3.67,body,neon,false,Enum.PartType.Cylinder,CFrame.Angles(0,math.pi/2,0))
		field.Transparency = .38
	elseif style == "laser" then
		for _, dx in ipairs({-2.27,2.27}) do at(parent,frame,"Emitter",x+dx,2.48,z,1.1,3,.85,body,metal,true) end
		for i = 1, 3 do at(parent,frame,"Energy beam",x,1.72+.65*i,z,4.6,.1,.12,accent,neon) end
	else
		at(parent,frame,"Controls",x,1.73,z,3.8,1.71,2.55,body,metal,true)
		local panel = at(parent,frame,"Control panel",x,2.69,z+.13,3.48,.43,1.66,accent,neon,false,nil,CFrame.Angles(-.32,0,0))
		if kind == "holo" then
			local screen = at(parent,frame,"Hologram",x,4.12,z,3.7,1.8,.12,accent,neon)
			screen.Transparency = .45
			for i = 1, 3 do at(parent,frame,"Hologram line",x-.42,3.68+i*.28,z+.09,i*.76,.065,.035,white,neon) end
		end
		if kind == "final" then P.light(panel,accent,9,.72) end
	end
end

local function lights(parent, frame, floor, accent)
	for _, x in ipairs({-27,0,27}) do
		at(parent,frame,"Light support",x,7.4,-25.15,.44,14.8,.45,ink,metal)
		at(parent,frame,"Light boom",x,12.95,-18.15,.45,.34,14.5,ink,metal)
		local light = at(parent,frame,"Strip light",x,12.7,-14,5.3,.32,1.5,accent,neon)
		P.light(light,accent,22,1.02)
	end
	if floor == 4 then ring(parent,frame,0,12.5,2,3,3,accent,false) end
end

local function cashSource(model,frame,floor,x,y,z,primary,sidetrack)
	local marker = at(model,frame,"PacketStart",x,y,z,.1,.1,.1,white)
	marker.Transparency = 1
	marker:SetAttribute("Floor",floor)
	marker:SetAttribute("Primary",primary == true)
	marker:SetAttribute("PhaseOffset",primary and 0 or (x+33)*.03)
	local laneZ = sidetrack and -3.6 or -8
	marker:SetAttribute("Waypoint",(frame * CFrame.new(x,1.87,laneZ)).Position)
	marker:SetAttribute("Finish",(frame * CFrame.new(29,1.95,-8)).Position)
	if sidetrack then marker:SetAttribute("Merge",(frame*CFrame.new(24,1.87,laneZ)).Position) end
end

function F.upgrade(parent, plotFrame, spec)
	local frame = F.floorFrame(plotFrame, spec.floor)
	local kind, floor = spec.kind, spec.floor
	local accent = Floors.Names[floor].color
	local m = P.make("Model",parent,spec.id)
	m:SetAttribute("UpgradeId",spec.id)
	CollectionService:AddTag(m,"FactoryBuild")
	local xy = slots[spec.slot]
	if kind == "starter" then
		lane(m,frame,floor,kind)
		vault(m,frame,floor,1)
		machine(m,frame,floor,({"dropper","mega","laser","reactor"})[floor],xy[1],xy[2])
		if floor >= 3 then
			at(m,frame,"Transfer arm",xy[1],3.1,-13.45,1.08,.58,11,Floors.Names[floor].body,metal)
			at(m,frame,"Fabrication nozzle",xy[1],2.92,-8,1.45,.73,1.23,accent,neon)
		end
		local nozzle = ({3.88,5.9,2.6,2.6})[floor]
		cashSource(m,frame,floor,-28.65,nozzle,-8,true,false)
	elseif kind == "speed" or kind == "belt" then
		local x = xy[1]
		for _, dz in ipairs({-2.2,2.2}) do
			at(m,frame,"Upgrade guard",x,1.87,-8+dz,8,.67,.32,accent,neon)
		end
		at(m,frame,"Scanner",x,3.15,-8,.78,.34,4.6,kind=="belt" and gold or accent,metal)
	elseif kind == "doublebelt" then
		lane(m,frame,floor,kind)
		at(m,frame,"Merge guide",26.35,1.51,-5.86,.37,.18,6.02,accent,neon,false,nil,CFrame.Angles(0,-.69,0))
		cashSource(m,frame,floor,-26,2.35,-3.6,false,true)
	elseif kind == "magnetic" or kind == "antigravity" then
		for _, x in ipairs({-26,-12,2,16,26}) do
			for _, side in ipairs({-1,1}) do
				at(m,frame,"Field pylon",x,2.12,-8+side*2,.51,1.42,.57,accent,neon)
			end
			at(m,frame,"Floating roller",x,1.71,-8,.17,.12,2.8,accent,neon)
		end
	elseif kind == "walls" then
		wall(m,frame,floor)
	elseif kind == "chest" then
		vault(m,frame,floor,spec.order < 10 and 2 or 3)
	elseif kind == "stairs" then
		stairs(m,frame,accent)
	elseif kind == "lights" then
		lights(m,frame,floor,accent)
	elseif kind == "doors" then
		local door = at(m,frame,"SecurityGate",0,4.05,28.35,8.8,8.1,.62,accent,metal,true)
		door:SetAttribute("BaseCFrame",door.CFrame)
		for _, x in ipairs({-4.86,4.86}) do at(m,frame,"Door guide",x,4.05,28.35,.55,8.1,1.2,ink,metal,true) end
	elseif kind == "pipes" then
		for i=1,3 do
			at(m,frame,"Steam riser",-39+i*1.41,5.15,-25.7,.65,10.22,.66,i%2==0 and accent or ink,metal)
			at(m,frame,"Steam header",-15,9.5+i*.71,-25.7,45,.4,.44,i%2==0 and accent or ink,metal)
		end
	elseif kind == "lift" then
		at(m,frame,"Elevator controller",-36,.74,21,5.4,1.48,4.7,ink,metal,true)
		at(m,frame,"Lift status",-36,1.57,21,3.5,.27,2.7,accent,neon)
	elseif kind == "roof" then
		at(m,frame,"Roof plane",0,13.56,0,85.7,.73,59.6,dark,metal,true)
		for _, z in ipairs({-29.8,29.8}) do at(m,frame,"Roof lighting",0,13.55,z,86,.48,.34,accent,neon) end
		for _, x in ipairs({-42.7,42.7}) do at(m,frame,"Roof lighting",x,13.55,0,.31,.48,59.7,accent,neon) end
	elseif kind == "sign" then
		local banner = at(m,frame,"Factory marquee",0,16.03,29.05,49,4.65,1.15,ink,metal)
		P.surface(banner,"Brainrot","BRAINROT FACTORY",nil,accent)
		P.surface(banner,"Reverse","BRAINROT FACTORY",Enum.NormalId.Front,accent)
		at(m,frame,"Marquee trim",0,18.55,29.05,50,.3,1.35,accent,neon)
	else
		local x, z = xy[1], xy[2]
		if kind == "rail" and (spec.floor == 2 or spec.floor == 4) or kind == "final" and spec.floor >= 3 then
			x, z = x + (x < 0 and 5 or -5), z < 0 and 7.8 or -23.5
		end
		machine(m,frame,floor,kind,x,z)
		local style = machineKinds[kind]
		if style == "dropper" then
			local y = kind=="mega" and 5.9 or 3.88
			cashSource(m,frame,floor,x,y,-8,false,false)
		elseif style=="core" or style=="furnace" or style=="crystal" or style=="portal" then
			cashSource(m,frame,floor,x,2.52,z<0 and z+3.4 or z-3.4,false,false)
		end
	end
	return m
end

function F.padFrame(plotFrame, upgrade)
	local frame = F.floorFrame(plotFrame,upgrade.floor)
	local spot = featurePads[upgrade.kind] or slots[upgrade.slot]
	local x, z = spot[1], spot[2]
	if not featurePads[upgrade.kind] then z = z < 0 and z + 5.1 or z + 5.2 end
	return frame * CFrame.new(x,.27,z)
end

function F.collectFrame(plotFrame,floor)
	return F.floorFrame(plotFrame,floor) * CFrame.new(32,.28,5)
end

function F.costumeFrame(plotFrame,floor)
	return F.floorFrame(plotFrame,floor) * CFrame.new(27,.27,26)
end

function F.liftFrame(plotFrame,floor)
	return F.floorFrame(plotFrame,floor) * CFrame.new(-34,.3,23)
end

return F
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Parts</string>
          <string name="Source"><![CDATA[local Parts = {}
Parts.Ink = Color3.fromRGB(23, 35, 57)
Parts.White = Color3.fromRGB(242, 250, 255)

function Parts.make(className, parent, name)
	local item = Instance.new(className)
	item.Name = name
	item.Parent = parent
	return item
end

function Parts.part(parent, name, size, transform, color, material, solid, shape)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = transform
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = solid == true
	part.CanTouch = false
	part.CanQuery = solid == true
	part.CastShadow = solid == true
	if shape then part.Shape = shape end
	part.Parent = parent
	return part
end

function Parts.surface(part, name, text, face, color)
	local gui = Parts.make("SurfaceGui", part, name)
	gui.Face = face or Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(720, 144)
	gui.LightInfluence = 0
	gui.MaxDistance = 100
	local label = Parts.make("TextLabel", gui, "Label")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = color or Parts.White
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.Text = text
	return label
end

function Parts.billboard(part, name, text, width, height, offset, distance)
	local gui = Parts.make("BillboardGui", part, name)
	gui.Size = UDim2.fromOffset(width, height)
	gui.StudsOffsetWorldSpace = Vector3.new(0, offset, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = distance or 43
	gui.LightInfluence = 0
	local label = Parts.make("TextLabel", gui, "Label")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Parts.Ink
	label.BackgroundTransparency = 0.14
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextWrapped = true
	label.TextColor3 = Parts.White
	label.Text = text
	local pad = Parts.make("UIPadding", label, "Padding")
	pad.PaddingLeft = UDim.new(0, 6)
	pad.PaddingRight = UDim.new(0, 6)
	pad.PaddingTop = UDim.new(0, 3)
	pad.PaddingBottom = UDim.new(0, 3)
	local corner = Parts.make("UICorner", label, "Corner")
	corner.CornerRadius = UDim.new(0, 7)
	return label
end

function Parts.translate(item, en, ru, property)
	item:SetAttribute("TextEN", en)
	item:SetAttribute("TextRU", ru)
	item:SetAttribute("TextProperty", property or "Text")
	game:GetService("CollectionService"):AddTag(item, "FactoryText")
end

function Parts.light(part, color, range, brightness)
	local light = Parts.make("PointLight", part, "Glow")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	return light
end

return Parts
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[local P = require(script.Parent.Parts)
local Lighting = game:GetService("Lighting")
local World = {}

local ink = P.Ink
local warm = Color3.fromRGB(255, 208, 100)
local teal = Color3.fromRGB(95, 238, 190)
local lawn = Color3.fromRGB(118, 198, 126)
local pavement = Color3.fromRGB(187, 205, 208)
local asphalt = Color3.fromRGB(64, 80, 107)
local neon = Enum.Material.Neon

local function box(parent, name, x, y, z, sx, sy, sz, color, solid, material)
	return P.part(parent, name, Vector3.new(sx, sy, sz), CFrame.new(x, y, z), color, material, solid)
end

local function tree(parent, x, z, variation)
	local m = P.make("Model", parent, "Tree")
	box(m, "Mulch", x, 0.14, z, 5, 0.25, 5, Color3.fromRGB(87, 107, 84), false)
	box(m, "Trunk", x, 2.9, z, 0.9, 5.8, 0.9, Color3.fromRGB(103, 71, 60), true)
	local greens = { Color3.fromRGB(78, 174, 111), Color3.fromRGB(100, 206, 121), Color3.fromRGB(54, 153, 120) }
	for i = 1, 3 do
		local spread = i == 1 and -1.1 or i == 2 and 0.9 or 0
		P.part(m, "Canopy", Vector3.new(5.2, 4.1, 5), CFrame.new(x + spread, 5.4 + i * 0.85, z + spread * 0.5), greens[(i + variation) % 3 + 1], nil, false, Enum.PartType.Ball)
	end
end

local function lamp(parent, x, z, side)
	local m = P.make("Model", parent, "Street lamp")
	box(m, "Base", x, 0.38, z, 1.7, 0.7, 1.7, ink, true)
	box(m, "Post", x, 4, z, 0.45, 7.7, 0.45, ink, true)
	box(m, "Arm", x, 7.58, z + 0.65 * side, 0.52, 0.35, 2.2, ink)
	local head = box(m, "Lamp", x, 7.38, z + 1.5 * side, 1.35, 0.2, 1.2, warm, false, neon)
	P.light(head, warm, 15, 0.6)
end

local function shop(parent, x, z, note, ru, color, side, tall)
	local m = P.make("Model", parent, note)
	local height = tall and 19 or 12
	box(m, "Foundation", x, 0.3, z, 23, 0.6, 22, pavement, true)
	box(m, "Building", x, height / 2, z, 20, height, 18, color, true)
	box(m, "Roof", x, height + 0.48, z, 21.6, 1, 19.5, ink, true)
	box(m, "Roofline", x, height - 0.45, z, 21, 0.32, 19, warm, false)
	local face = side > 0 and Enum.NormalId.Back or Enum.NormalId.Front
	local sign = box(m, "Store sign", x, 7, z + 9.3 * side, 15, 2.4, 0.42, ink, false)
	P.translate(P.surface(sign, "Name", note, face), note, ru)
	for i = -1, 1 do
		local pane = box(m, "Shop window", x + i * 5, 3, z + 9.12 * side, 4.1, 4.1, 0.24, Color3.fromRGB(148, 224, 241), false, Enum.Material.Glass)
		pane.Reflectance = 0.17
		box(m, "Awning", x + i * 5, 5.75, z + 10.1 * side, 4.9, 0.5, 2.7, i == 0 and warm or P.White, false)
		if tall then box(m, "Upstairs window", x + i * 5, 13, z + 9.12 * side, 3.8, 5, 0.25, Color3.fromRGB(180, 221, 243), false, Enum.Material.Glass) end
	end
	box(m, "Roof vent", x + 5, height + 2, z + 3, 5, 2.3, 5, pavement, false)
end

local function bench(parent, x, z)
	box(parent, "Bench seat", x, 1.2, z, 4.5, 0.35, 1.45, Color3.fromRGB(164, 109, 62), true)
	box(parent, "Bench back", x, 1.85, z - 0.7, 4.5, 0.7, 0.3, Color3.fromRGB(164, 109, 62), false)
	for _, dx in ipairs({-1.5, 1.5}) do box(parent, "Bench leg", x + dx, 0.55, z, 0.35, 1.1, 1, ink, false) end
end

local function plaza(parent)
	local m = P.make("Model", parent, "Foundry Plaza")
	box(m, "Plaza foundation", 0, 0.14, 0, 52, 0.28, 54, pavement, true)
	for x = -2, 2 do
		for z = -2, 2 do
			box(m, "Plaza paver", x * 9, 0.29, z * 9, 8.85, 0.13, 8.85,
				(x + z) % 2 == 0 and P.White or Color3.fromRGB(207, 224, 226), false)
		end
	end
	local spawn = P.make("SpawnLocation", m, "CentralSpawn")
	spawn.CFrame = CFrame.new(0, 0.63, 4)
	spawn.Size = Vector3.new(10, 0.3, 10)
	spawn.Color = teal
	spawn.Material = neon
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.AllowTeamChangeOnTouch = false
	for _, x in ipairs({-20.5, 20.5}) do
		box(m, "Plaza gateway post", x, 6.5, -11, 2.2, 13, 2.4, ink, true)
		box(m, "Gateway stripe", x, 6.5, -9.7, 0.48, 11, 0.22, teal, false, neon)
		bench(m, x, 16)
	end
	local header = box(m, "Factory district marquee", 0, 12.2, -11, 42, 3.6, 1.4, ink, false)
	P.surface(header, "District title", "BRAINROT FACTORY")
	P.surface(header, "Rear district title", "BRAINROT FACTORY", Enum.NormalId.Front)
	box(m, "Marquee top", 0, 14, -11, 43, 0.25, 1.6, teal, false, neon)
	for direction = -1, 1, 2 do
		local sign = box(m, "Plot wayfinding", direction * 16, 4.1, 21, 12, 2.5, 0.48, ink, false)
		local en = direction < 0 and "‹  01 · 02 · 05 · 06" or "03 · 04 · 07 · 08  ›"
		local ru = direction < 0 and "‹  01 · 02 · 05 · 06" or "03 · 04 · 07 · 08  ›"
		P.translate(P.surface(sign, "Directions", en, nil, warm), en, ru)
		box(m, "Wayfinding post", direction * 16, 1.9, 21, 0.42, 3.8, 0.42, ink, false)
	end
	local board = box(m, "Leaderboard", 0, 5.6, -21, 25, 9.7, 0.85, ink, true)
	box(m, "Board plinth", 0, 0.5, -21, 26.5, 0.9, 2.4, Color3.fromRGB(96, 120, 140), true)
	local openPlots = box(m, "AvailablePlots", 19.5, 3.55, -17, 11, 2.75, .55, ink, false)
	box(m, "Availability post", 19.5, 1.45, -17, .48, 2.9, .55, ink, false)
	local available = P.surface(openPlots, "Open plots", "OPEN PLOTS", nil, teal)
	P.translate(available, "OPEN PLOTS", "СВОБОДНЫЕ УЧАСТКИ")
	return spawn, board, available
end

local function setupLighting()
	local atmosphere = Lighting:FindFirstChild("FactoryAtmosphere") or P.make("Atmosphere", Lighting, "FactoryAtmosphere")
	atmosphere.Density = 0.23
	atmosphere.Offset = 0.12
	atmosphere.Color = Color3.fromRGB(209, 230, 255)
	atmosphere.Decay = Color3.fromRGB(177, 195, 221)
	atmosphere.Glare = 0.12
	atmosphere.Haze = 0.85
	local bloom = Lighting:FindFirstChild("FactoryBloom") or P.make("BloomEffect", Lighting, "FactoryBloom")
	bloom.Intensity = 0.17
	bloom.Size = 27
	bloom.Threshold = 1.8
end

function World.build()
	setupLighting()
	local previous = workspace:FindFirstChild("BrainrotWorld")
	if previous and previous:GetAttribute("StaticFormat") == 1 then
		local center = previous.Scenery["Foundry Plaza"]
		return previous.Plots, center.CentralSpawn, center.Leaderboard, center.AvailablePlots["Open plots"].Label
	end
	if previous then previous:Destroy() end
	local root = P.make("Folder", workspace, "BrainrotWorld")
	local scenery = P.make("Folder", root, "Scenery")
	box(scenery, "District ground", 0, -1.05, 0, 474, 2.1, 263, lawn, true, Enum.Material.Grass)
	box(scenery, "Main road", 0, 0.06, 0, 458, 0.11, 44, asphalt, true, Enum.Material.Asphalt)
	for _, z in ipairs({-27, 27}) do
		box(scenery, "Sidewalk", 0, 0.16, z, 462, 0.3, 9, pavement, true, Enum.Material.Concrete)
		box(scenery, "Curb", 0, 0.25, z > 0 and 22.4 or -22.4, 462, 0.48, 0.4, P.White, true)
	end
	for x = -216, 216, 12 do
		if math.abs(x) > 28 then box(scenery, "Road marking", x, 0.129, 0, 6, 0.025, 0.32, warm) end
	end
	for _, x in ipairs({-112, -35, 35, 112}) do
		for stripe = -2, 2 do box(scenery, "Crosswalk", x + stripe * 1.35, 0.132, 0, 0.75, 0.025, 41, P.White) end
	end
	for _, side in ipairs({-1, 1}) do
		for i, x in ipairs({-226, -194, -123, -89, -20, 20, 89, 123, 194, 226}) do
			tree(scenery, x, side * 33, i)
			lamp(scenery, x + (i % 2 == 0 and -4 or 4), side * 28, -side)
		end
		for i, x in ipairs({-213, -107, -16, 16, 107, 213}) do tree(scenery, x, side * 118, i + 1) end
		box(scenery, "Boundary rail", 0, 2.1, side * 129, 474, 0.45, 0.56, ink, true)
		box(scenery, "Boundary footing", 0, 0.65, side * 129, 474, 1.3, 1.7, pavement, true)
		box(scenery, "Side containment", side * 236, 1.4, 0, 1.5, 2.8, 260, pavement, true)
		local wall = box(scenery, "District limit", side * 237, 18, 0, 1, 36, 264, ink, true)
		wall.Transparency = 1
		wall.CastShadow = false
		local endWall = box(scenery, "District limit", 0, 18, side * 131, 476, 36, 1, ink, true)
		endWall.Transparency = 1
		endWall.CastShadow = false
		for _, x in ipairs({-225, -175, -125, -75, -25, 25, 75, 125, 175, 225}) do
			box(scenery, "Boundary pillar", x, 1.5, side * 129, 1.25, 3, 1.25, ink, true)
		end
	end
	shop(scenery, -220, -66, "TOOL DEPOT", "ИНСТРУМЕНТЫ", Color3.fromRGB(80, 150, 193), 1, true)
	shop(scenery, 220, -66, "ROBOT REPAIR", "РЕМОНТ РОБОТОВ", Color3.fromRGB(214, 123, 130), 1, false)
	shop(scenery, -220, 66, "MINT CAFE", "МЯТНОЕ КАФЕ", Color3.fromRGB(102, 169, 138), -1, false)
	shop(scenery, 220, 66, "PARTS & PARCELS", "ДЕТАЛИ И ПОСЫЛКИ", Color3.fromRGB(173, 128, 194), -1, true)
	local spawn, board, available = plaza(scenery)
	local plots = P.make("Folder", root, "Plots")
	root:SetAttribute("StaticFormat",1)
	return plots, spawn, board, available
end

function World.plotFrame(id)
	local column = (id - 1) % 4
	local side = id <= 4 and -1 or 1
	return CFrame.new((column - 1.5) * 106,0,side * 69) * CFrame.Angles(0,side == 1 and math.pi or 0,0)
end

function World.plotShell(parent, id, frame)
	local name = string.format("Plot%02d",id)
	local previous = parent:FindFirstChild(name)
	if previous then return previous, previous["Plot marquee"].OwnerTitle.Label end
	local model = P.make("Model", parent, name)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	model:SetAttribute("PlotId", id)
	model:SetAttribute("Owner", 0)
	local function at(name, x, y, z, sx, sy, sz, color, solid)
		return P.part(model, name, Vector3.new(sx, sy, sz), frame * CFrame.new(x, y, z), color, nil, solid)
	end
	at("Plot lot", 0, 0.22, 0, 88, 0.44, 67, Color3.fromRGB(163, 196, 169), true)
	at("Entrance path", 0, 0.18, 36, 14, 0.35, 12, pavement, true)
	for _, x in ipairs({-43.9, 43.9}) do at("Plot border", x, 0.54, 0, 0.35, 0.15, 67, P.White) end
	for _, z in ipairs({-33.3, 33.3}) do at("Plot border", 0, 0.54, z, 88, 0.15, 0.35, P.White) end
	for _, x in ipairs({-8, 8}) do
		at("Gate post", x, 3.4, 32.5, 1.5, 6.2, 1.8, ink, true)
		at("Gate stripe", x, 3.4, 33.42, 0.37, 4.6, 0.2, teal)
	end
	local header = at("Plot marquee", 0, 6.3, 32.5, 17.5, 2.1, 1.1, ink)
	local title = P.surface(header, "OwnerTitle", "FREE PLOT", nil, teal)
	P.translate(title, "FREE PLOT", "СВОБОДНЫЙ УЧАСТОК")
	local display = at("District marker", 13.5, 2.2, 34.5, 4.2, 3.2, 0.56, ink)
	P.surface(display, "Plot number", string.format("%02d", id), nil, warm)
	return model, title
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterGui" referent="36">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
    <Item class="ScreenGui" referent="37">
      <Properties>
        <string name="Name">FactoryHUD</string>
        <int name="DisplayOrder">12</int>
        <token name="ScreenInsets">2</token>
        <bool name="ResetOnSpawn">false</bool>
        <token name="ZIndexBehavior">1</token>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="38">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">55</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="39">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="40">
        <Properties>
          <string name="Name">BrainrotClient</string>
        </Properties>
        <Item class="LocalScript" referent="41">
          <Properties>
            <string name="Name">Boot</string>
            <string name="Source"><![CDATA[local player = game:GetService("Players").LocalPlayer
local shared = game:GetService("ReplicatedStorage"):WaitForChild("Brainrot")
local network = shared:WaitForChild("Network")
local gui = player:WaitForChild("PlayerGui"):WaitForChild("FactoryHUD")
require(script.Parent.UIController).start(gui,network)
require(script.Parent.EffectsController).start(gui,network)
require(script.Parent.WorldController).start()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">EffectsController</string>
            <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Brainrot")
local Audio = require(Shared.AudioConfig)
local Game = require(Shared.GameConfig)
local Floors = require(Shared.FloorConfig)
local fmt = require(Shared.NumberFormat)

local Effects = {}
local rgb = Color3.fromRGB
local player = Players.LocalPlayer

local function asset(name)
	local id = Audio[name]
	if id and id ~= "" then
		return id:match("^%d+$") and ("rbxassetid://" .. id) or id
	end
	return Audio.Builtin[name]
end

local function createSound(parent,name,id,volume,looped)
	local sound = Instance.new("Sound")
	sound.Name,sound.SoundId,sound.Volume,sound.Looped = name,id,volume,looped == true
	sound.Parent = parent
	return sound
end

local function part(parent,name)
	local item = Instance.new("Part")
	item.Name,item.Anchored,item.CanCollide,item.CanTouch,item.CanQuery,item.CastShadow = name,true,false,false,false,false
	item.Material = Enum.Material.Neon
	item.Parent = parent
	return item
end

function Effects.start(gui,events)
	local effects = Instance.new("Folder")
	effects.Name,effects.Parent = "LocalFactoryEffects",workspace
	local audio = Instance.new("Folder")
	audio.Name,audio.Parent = "FactoryAudio",SoundService

	local purchase = createSound(audio,"Purchase",asset("Purchase"),.35)
	local collect = createSound(audio,"Collect",asset("Collect"),.42)
	local celebrate = createSound(audio,"Celebrate",asset("Celebrate"),.31)
	if Audio.Collect == "" then collect.PlaybackSpeed = 1.49 end
	if Audio.Celebrate == "" then celebrate.PlaybackSpeed = .97 end
	local musicFile = asset("Music")
	local music = musicFile and createSound(audio,"Music",musicFile,.18,true)
	local notes = {}
	if not music then
		for i = 1,4 do notes[i] = createSound(audio,"Music voice",asset("Note"),i == 4 and .045 or .085) end
	end
	local function musicState()
		if not music then
			if player:GetAttribute("Music") == false then for _, note in ipairs(notes) do note:Stop() end end
			return
		end
		if player:GetAttribute("Ready") and player:GetAttribute("Music") ~= false then music:Play() else music:Stop() end
	end
	player:GetAttributeChangedSignal("Ready"):Connect(musicState)
	player:GetAttributeChangedSignal("Music"):Connect(musicState)
	musicState()
	if not music then
		local score = {0,7,12,16,12,7,2,9,14,17,14,9,4,11,16,19,16,11,2,9,14,17,12,7}
		task.spawn(function()
			local i = 0
			while gui.Parent do
				if player:GetAttribute("Ready") and player:GetAttribute("Music") ~= false then
					local lead = notes[i%3+1]
					lead.PlaybackSpeed = 0.65 * 2^(score[i+1]/12)
					lead:Play()
					if i%6==0 then
						local bass = notes[4]
						bass.PlaybackSpeed = .32 * 2^(score[i+1]/12)
						bass:Play()
					end
					i = (i+1)%#score
				end
				task.wait(.49)
			end
		end)
	end

	local audioAnchor = part(effects,"Machinery audio point")
	audioAnchor.Transparency = 1
	local machinery = createSound(audioAnchor,"Conveyor",asset("Conveyor"),.16,true)
	local generator = createSound(audioAnchor,"Generator",asset("Generator"),.16)
	machinery.RollOffMinDistance, machinery.RollOffMaxDistance = 10,68
	generator.RollOffMinDistance,generator.RollOffMaxDistance = 10,55
	if Audio.Conveyor == "" then machinery.PlaybackSpeed = .49 end
	if Audio.Generator == "" then generator.PlaybackSpeed = .85 end

	local tokens = {}
	for i=1,Game.PacketPoolSize do
		local block = part(effects,"Cash billet")
		block.Size,block.Transparency = Vector3.new(1.08,.29,.75),1
		local band = part(effects,"Cash band")
		band.Size,band.Color,band.Transparency = Vector3.new(.26,.32,.8),rgb(255,247,216),1
		tokens[i] = {block=block,band=band}
	end

	local sparks = {}
	for i=1,10 do
		local anchor = part(effects,"Particle point")
		anchor.Transparency,anchor.Size = 1,Vector3.one * .25
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Enabled = false
		emitter.Rate = 0
		emitter.Lifetime = NumberRange.new(.24,.66)
		emitter.Speed = NumberRange.new(3,9)
		emitter.Size = NumberSequence.new(.42,.06)
		emitter.SpreadAngle = Vector2.new(80,80)
		emitter.Acceleration = Vector3.new(0,-14,0)
		emitter.LightEmission = .65
		emitter.Parent = anchor
		sparks[i] = {anchor=anchor,emitter=emitter}
	end
	local cursor = 0
	local function spray(position,color,count)
		cursor = cursor%#sparks+1
		local effect = sparks[cursor]
		effect.anchor.Position = position
		effect.emitter.Color = ColorSequence.new(color)
		effect.emitter:Emit(count)
	end

	local markers = {}
	local function bindMarker(marker)
		markers[marker] = {}
	end
	for _, marker in ipairs(CollectionService:GetTagged("FactoryLane")) do bindMarker(marker) end
	CollectionService:GetInstanceAddedSignal("FactoryLane"):Connect(bindMarker)
	CollectionService:GetInstanceRemovedSignal("FactoryLane"):Connect(function(marker) markers[marker] = nil end)
	local visibleCount, nextScan = 0,0
	local nearby, closest = {},nil
	local function scan(origin,current)
		table.clear(nearby)
		closest = nil
		local closestDistance = 66
		local world = workspace:FindFirstChild("BrainrotWorld")
		local sites = world and world:FindFirstChild("Plots")
		for marker,state in pairs(markers) do
			local id,floor = marker:GetAttribute("PlotId"),marker:GetAttribute("Floor")
			local site = sites and id and sites:FindFirstChild(string.format("Plot%02d",id))
			local epoch = site and floor and site:GetAttribute("LaneEpoch" .. floor)
			local distance = (marker.Position-origin).Magnitude
			if epoch and current >= epoch and distance < 135 and marker:IsDescendantOf(workspace) then
				state.marker,state.floor,state.epoch = marker,floor,epoch
				state.finish,state.waypoint = marker:GetAttribute("Finish"),marker:GetAttribute("Waypoint")
				state.merge,state.offset = marker:GetAttribute("Merge"),marker:GetAttribute("PhaseOffset") or 0
				state.priority = distance + (marker:GetAttribute("Primary") and 0 or 17)
				table.insert(nearby,state)
				if marker:GetAttribute("Primary") and distance < closestDistance then closest,closestDistance = marker,distance end
			else
				state.cycle = nil
			end
		end
		table.sort(nearby,function(a,b) return a.priority < b.priority end)
		if closest and player:GetAttribute("Sound") ~= false then
			audioAnchor.Position = closest.Position
			if not machinery.IsPlaying then machinery:Play() end
		elseif machinery.IsPlaying then
			machinery:Stop()
		end
	end

	RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		if not camera then return end
		local origin, current = camera.CFrame.Position,workspace:GetServerTimeNow()
		if current >= nextScan then
			nextScan = current + .22
			scan(origin,current)
		end
		local count = 0
		for _, state in ipairs(nearby) do
			if count >= #tokens then break end
			local marker,floor = state.marker,state.floor
			local elapsed = current - state.epoch - state.offset
			if elapsed >= 0 and marker.Parent and state.finish and state.waypoint then
				local interval = Game.PacketInterval
				local cycle = math.floor(elapsed/interval)
				local phase = (elapsed%interval)/interval
				count += 1
				local token = tokens[count]
				local position
				if phase < .18 then
					position = marker.Position:Lerp(state.waypoint,phase/.18)
				elseif state.merge and phase > .88 then
					position = state.merge:Lerp(state.finish,(phase-.88)/.12)
				else
					position = state.waypoint:Lerp(state.merge or state.finish,(phase-.18)/(state.merge and .70 or .82))
				end
				local transform = CFrame.new(position) * CFrame.Angles(0,phase*.8,.14*math.sin(phase*math.pi))
				token.block.CFrame,token.band.CFrame = transform,transform
				token.block.Color = floor == 4 and Color3.fromHSV((cycle*.17+phase*.16)%1,.72,1) or Floors.Names[floor].cash
				token.block.Transparency,token.band.Transparency = 0,.08
				if state.cycle and state.cycle < cycle then
					if state.offset==0 and (state.finish-origin).Magnitude < 68 then spray(state.finish,Floors.Names[floor].cash,5) end
					if marker==closest and player:GetAttribute("Sound") ~= false then generator:Play() end
				end
				state.cycle = cycle
			end
		end
		for i=count+1,visibleCount do tokens[i].block.Transparency,tokens[i].band.Transparency = 1,1 end
		visibleCount = count
	end)
	player:GetAttributeChangedSignal("Sound"):Connect(function()
		if player:GetAttribute("Sound")==false then
			for _, sound in ipairs({purchase,collect,celebrate,machinery,generator}) do sound:Stop() end
		end
	end)

	local function flashBuild(id,plotId)
		for _, model in ipairs(CollectionService:GetTagged("FactoryBuild")) do
			if model:GetAttribute("UpgradeId")==id and model:GetAttribute("PlotId")==plotId then
				local highlight = Instance.new("Highlight")
				highlight.Adornee,highlight.DepthMode = model,Enum.HighlightDepthMode.Occluded
				highlight.FillColor,highlight.OutlineColor = rgb(110,241,190),rgb(203,255,236)
				highlight.FillTransparency,highlight.OutlineTransparency = .35,.05
				highlight.Parent = effects
				TweenService:Create(highlight,TweenInfo.new(.75),{FillTransparency=1,OutlineTransparency=1}):Play()
				Debris:AddItem(highlight,.8)
				return true
			end
		end
	end

	local function floatingMoney(position,value)
		local point = part(effects,"Collection popup")
		point.Transparency,point.Position = 1,position + Vector3.new(0,3.5,0)
		point.Size = Vector3.one * .1
		local tag = Instance.new("BillboardGui")
		tag.Size,tag.AlwaysOnTop,tag.MaxDistance = UDim2.fromOffset(160,44),true,75
		tag.Parent = point
		local text = Instance.new("TextLabel")
		text.Size,text.BackgroundTransparency = UDim2.fromScale(1,1),1
		text.Font,text.TextSize,text.TextColor3 = Enum.Font.GothamBold,27,rgb(132,255,181)
		text.TextStrokeTransparency,text.Text = .24,"+$" .. fmt(value)
		text.Parent = tag
		local timing = TweenInfo.new(.87,Enum.EasingStyle.Quad)
		TweenService:Create(point,timing,{Position=position+Vector3.new(0,7.2,0)}):Play()
		TweenService:Create(text,timing,{TextTransparency=1,TextStrokeTransparency=1}):Play()
		Debris:AddItem(point,.96)
	end

	local function confetti(burst)
		local colors = {rgb(96,238,173),rgb(255,215,92),rgb(241,129,228),rgb(120,215,255)}
		local random = Random.new()
		for i=1,burst do
			local flake = Instance.new("Frame")
			flake.Size = UDim2.fromOffset(random:NextInteger(4,9),random:NextInteger(7,15))
			flake.Position = UDim2.fromScale(random:NextNumber(),-.06-random:NextNumber()*.31)
			flake.BackgroundColor3,flake.BorderSizePixel,flake.ZIndex = colors[i%#colors+1],0,20
			flake.Rotation = random:NextInteger(0,170)
			flake.Parent = gui
			local time = random:NextNumber(.8,1.95)
			TweenService:Create(flake,TweenInfo.new(time),{
				Position = flake.Position + UDim2.fromScale(random:NextNumber(-.28,.28),1.28),
				Rotation = flake.Rotation + random:NextInteger(-330,330), BackgroundTransparency=.38,
			}):Play()
			Debris:AddItem(flake,time+.1)
		end
	end

	events.WorldFX.OnClientEvent:Connect(function(kind,position,plotId,value)
		if kind=="build" then
			spray(position+Vector3.new(0,1.2,0),rgb(100,246,190),21)
			if not flashBuild(value,plotId) then task.delay(.25,flashBuild,value,plotId) end
		elseif kind=="collect" then
			spray(position+Vector3.new(0,1,0),rgb(255,218,103),16)
			floatingMoney(position,value)
		elseif kind=="unlock" then
			spray(position+Vector3.new(0,1.4,0),Floors.Names[value].color,30)
		end
	end)
	events.Feedback.OnClientEvent:Connect(function(kind)
		local sound = player:GetAttribute("Sound") ~= false
		if kind=="collected" then
			if sound then collect:Play() end
		elseif kind=="upgrade" then
			if sound then purchase:Play() end
		elseif kind=="costume" or kind=="floor" or kind=="completed" then
			if sound then celebrate:Play() end
			confetti(kind=="completed" and 48 or 22)
		end
	end)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Brainrot")
local Locale = require(Shared.Locale)
local Economy = require(Shared.EconomyConfig)
local Floors = require(Shared.FloorConfig)
local Costumes = require(Shared.CostumeConfig)
local fmt = require(Shared.NumberFormat)

local UI = {}
local player = Players.LocalPlayer
local rgb = Color3.fromRGB
local ink, panel, lighter = rgb(18,28,47), rgb(29,44,68), rgb(43,61,88)
local muted, white, mint, sky, gold = rgb(183,204,224), rgb(244,251,255), rgb(111,246,185), rgb(106,220,255), rgb(255,210,102)

local function make(class, parent, props)
	local object = Instance.new(class)
	for key, value in pairs(props or {}) do object[key] = value end
	object.Parent = parent
	return object
end

local function round(object, radius)
	make("UICorner",object,{CornerRadius=UDim.new(0,radius)})
end

local function outline(object, color, alpha)
	make("UIStroke",object,{Color=color,Transparency=alpha,Thickness=1,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
end

local function label(parent,text,size,color)
	return make("TextLabel",parent,{
		BackgroundTransparency=1, Text=text, Font=Enum.Font.GothamBold, TextColor3=color or white,
		TextSize=size, TextXAlignment=Enum.TextXAlignment.Left, RichText=false,
	})
end

local function button(parent,text,color,activated)
	local control = make("TextButton",parent,{
		BackgroundColor3=color or lighter, Text=text, TextColor3=white, TextSize=14, Font=Enum.Font.GothamBold,
		TextWrapped=true, AutoButtonColor=true, Selectable=true,
	})
	round(control,8)
	if activated then control.Activated:Connect(activated) end
	return control
end

local function boundedText(text,limit,min)
	text.TextScaled = true
	make("UITextSizeConstraint",text,{MaxTextSize=limit,MinTextSize=min or 8})
end

function UI.start(gui,events)
	local language = player:GetAttribute("Language") or (string.sub(string.lower(player.LocaleId),1,2) == "ru" and "ru" or "en")
	local function tr(key,...) return Locale(language,key,...) end
	local function attr(key,default)
		local value = player:GetAttribute(key)
		if value == nil then return default end
		return value
	end

	local hud = make("Frame",gui,{
		Name="Dashboard", Position=UDim2.fromOffset(12,12), Size=UDim2.new(1,-24,0,166),
		BackgroundColor3=ink, BackgroundTransparency=.04,
	})
	make("UISizeConstraint",hud,{MaxSize=Vector2.new(459,166)})
	round(hud,15)
	outline(hud,sky,.61)
	local marker = make("Frame",hud,{Position=UDim2.fromOffset(12,9),Size=UDim2.fromOffset(34,3),BackgroundColor3=mint,BorderSizePixel=0})
	round(marker,2)
	local title = label(hud,"BRAINROT FACTORY",19,white)
	title.Position, title.Size = UDim2.fromOffset(12,16),UDim2.new(1,-24,0,23)
	local floorLabel = label(hud,"",13,muted)
	floorLabel.Position, floorLabel.Size = UDim2.fromOffset(12,41),UDim2.new(1,-77,0,20)
	boundedText(floorLabel,14,9)
	local percent = label(hud,"0%",15,mint)
	percent.TextXAlignment = Enum.TextXAlignment.Right
	percent.Position, percent.Size = UDim2.new(1,-64,0,41),UDim2.fromOffset(52,20)
	local meter = make("Frame",hud,{Position=UDim2.fromOffset(12,66),Size=UDim2.new(1,-24,0,5),BackgroundColor3=lighter,BorderSizePixel=0})
	round(meter,4)
	local fill = make("Frame",meter,{Size=UDim2.fromScale(0,1),BackgroundColor3=mint,BorderSizePixel=0})
	round(fill,4)
	local progress = label(hud,"",11,muted)
	progress.Position, progress.Size = UDim2.fromOffset(12,76),UDim2.new(1,-24,0,15)

	local metrics = make("Frame",hud,{Position=UDim2.fromOffset(12,98),Size=UDim2.new(1,-24,0,55),BackgroundTransparency=1})
	local metricLabels, values = {}, {}
	for i, entry in ipairs({{"balance",mint},{"income",sky},{"chest",gold}}) do
		local card = make("Frame",metrics,{Position=UDim2.new((i-1)/3,(i-1)*3,0,0),Size=UDim2.new(1/3,-4,1,0),BackgroundColor3=panel})
		round(card,8)
		local key = label(card,"",10,muted)
		key.Position,key.Size = UDim2.fromOffset(7,6),UDim2.new(1,-13,0,15)
		boundedText(key,11)
		local value = label(card,"—",22,entry[2])
		value.Position,value.Size = UDim2.fromOffset(7,22),UDim2.new(1,-12,0,27)
		boundedText(value,23,12)
		metricLabels[entry[1]], values[entry[1]] = key,value
	end

	local actions = make("Frame",gui,{Name="Navigation",Position=UDim2.fromOffset(12,185),Size=UDim2.new(1,-24,0,43),BackgroundTransparency=1})
	make("UISizeConstraint",actions,{MaxSize=Vector2.new(459,43)})
	local shade = make("Frame",gui,{
		Name="Modal",Visible=false,Size=UDim2.fromScale(1,1),BackgroundColor3=ink,BackgroundTransparency=.32,
		BorderSizePixel=0,Active=true,ZIndex=12,
	})
	local modal = make("Frame",shade,{
		AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.49),Size=UDim2.new(1,-26,1,-66),
		BackgroundColor3=ink,ZIndex=13,
	})
	make("UISizeConstraint",modal,{MaxSize=Vector2.new(518,460),MinSize=Vector2.new(232,168)})
	round(modal,16)
	outline(modal,sky,.42)
	local modalName = label(modal,"",22,white)
	modalName.Position,modalName.Size,modalName.ZIndex = UDim2.fromOffset(17,11),UDim2.new(1,-75,0,37),14
	boundedText(modalName,23,12)
	local close = button(modal,"×",lighter)
	close.AnchorPoint,close.Position,close.Size,close.TextSize,close.ZIndex = Vector2.new(1,0),UDim2.new(1,-13,0,12),UDim2.fromOffset(43,39),25,14
	local rows = make("ScrollingFrame",modal,{
		Position=UDim2.fromOffset(13,61),Size=UDim2.new(1,-26,1,-74),CanvasSize=UDim2.new(),
		AutomaticCanvasSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=5,
		ScrollBarImageColor3=sky,ZIndex=14,ScrollingDirection=Enum.ScrollingDirection.Y,
	})
	make("UIListLayout",rows,{Padding=UDim.new(0,7),SortOrder=Enum.SortOrder.LayoutOrder})
	make("UIPadding",rows,{PaddingRight=UDim.new(0,7),PaddingBottom=UDim.new(0,8)})
	local current, rankBy = nil, "byCash"
	local function dismiss()
		current = nil
		shade.Visible = false
	end
	close.Activated:Connect(dismiss)

	local tutorial = make("Frame",gui,{Name="Tutorial",Position=UDim2.fromOffset(12,238),Size=UDim2.new(1,-24,0,53),
		BackgroundColor3=ink,BackgroundTransparency=.07,Visible=false,
	})
	make("UISizeConstraint",tutorial,{MaxSize=Vector2.new(459,53)})
	round(tutorial,9)
	outline(tutorial,mint,.53)
	local hint = label(tutorial,"",14,mint)
	hint.Position,hint.Size = UDim2.fromOffset(11,6),UDim2.new(1,-22,1,-12)
	hint.TextWrapped = true
	boundedText(hint,14,10)

	local toast = label(gui,"",17,white)
	toast.Name,toast.AnchorPoint,toast.Position = "Toast",Vector2.new(.5,.5),UDim2.fromScale(.5,.78)
	toast.Size,toast.ZIndex = UDim2.new(1,-25,0,49),17
	toast.TextXAlignment,toast.TextWrapped = Enum.TextXAlignment.Center,true
	toast.BackgroundTransparency,toast.BackgroundColor3,toast.Visible = .07,ink,false
	make("UISizeConstraint",toast,{MaxSize=Vector2.new(450,49)})
	make("UIPadding",toast,{PaddingLeft=UDim.new(0,9),PaddingRight=UDim.new(0,9)})
	round(toast,11)
	outline(toast,sky,.42)

	local function liner(text,color,height)
		local row = make("Frame",rows,{Size=UDim2.new(1,0,0,height or 60),BackgroundColor3=panel,ZIndex=15})
		round(row,9)
		local heading = label(row,text,15,color or white)
		heading.Position,heading.Size,heading.ZIndex = UDim2.fromOffset(12,7),UDim2.new(1,-24,0,25),16
		return row, heading
	end

	local function sub(row,text,size,color)
		local field = label(row,text,size or 12,color or muted)
		field.Position,field.Size,field.ZIndex = UDim2.fromOffset(12,31),UDim2.new(1,-24,0,20),16
		return field
	end

	local function control(row,text,width,callback)
		local push = button(row,text,lighter,callback)
		push.AnchorPoint,push.Position,push.Size,push.ZIndex = Vector2.new(1,.5),UDim2.new(1,-8,.5,0),UDim2.fromOffset(width,43),16
		return push
	end

	local function rerender()
		if not current then return end
		modalName.Text = tr(current)
		local order = 0
		for _, child in ipairs(rows:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
		local function add(text,color,height)
			local row, heading = liner(text,color,height)
			order += 1
			row.LayoutOrder = order
			return row,heading
		end
		if current == "costumes" then
			for i, costume in ipairs(Costumes) do
				local row, heading = add(language=="ru" and costume.ru or costume.name,costume.tint,69)
				local mask = attr("CostumesMask",0)
				local owned = bit32.band(mask,bit32.lshift(1,i-1)) > 0
				if owned then
					local equipped = attr("Equipped","") == costume.id
					heading.Size = UDim2.new(1,-112,0,50)
					heading.TextWrapped = true
					boundedText(heading,16,11)
					local action = control(row,tr(equipped and "remove" or "equip"),87,function()
						events.Action:FireServer("equip",equipped and "" or costume.id)
					end)
					action.BackgroundColor3 = equipped and rgb(75,66,126) or rgb(33,106,93)
				else
					boundedText(heading,16,10)
					local key = attr("Stage",0) >= i*20 and "availableCostume" or "lockedCostume"
					sub(row,tr(key,i,fmt(Economy.CostumePrices[i])))
				end
			end
		elseif current == "settings" then
			local row = add(tr("language"),white)
			local localeButton = control(row,language == "ru" and "Русский  /  EN" or "English  /  RU",124,function()
				events.Action:FireServer("language",language == "ru" and "en" or "ru")
			end)
			localeButton.TextSize = 13
			for _, entry in ipairs({{"Music","music"},{"Sound","sound"}}) do
				local enabled = attr(entry[1],true)
				local option = add(tr(entry[2]))
				local choice = control(option,tr(enabled and "on" or "off"),76,function()
					events.Action:FireServer(entry[2],not enabled)
				end)
				if enabled then choice.BackgroundColor3 = rgb(33,106,93) end
			end
			local access = add(tr("access"),white,68)
			if attr("Stage",0) >= 15 and attr("PlotId",0) > 0 then
				control(access,tr(attr("Doors",false) and "closedState" or "openState"),103,function()
					events.Action:FireServer("doors")
				end)
			else
				local note = sub(access,tr("doorLocked"))
				boundedText(note,12)
			end
		elseif current == "leaderboard" then
			local options = add("",nil,47)
			for i, key in ipairs({"byCash","byStage"}) do
				local tab = button(options,tr(key),key==rankBy and rgb(33,106,93) or lighter,function()
					rankBy = key
					rerender()
				end)
				tab.Position,tab.Size,tab.ZIndex = UDim2.new((i-1)*.5,4,0,3),UDim2.new(.5,-8,1,-6),16
			end
			local entries = {}
			for _, other in ipairs(Players:GetPlayers()) do
				if other:GetAttribute("Ready") then table.insert(entries,other) end
			end
			local rankStat = rankBy == "byStage" and "Stage" or "Cash"
			table.sort(entries,function(a,b)
				local diff = (a:GetAttribute(rankStat) or 0) - (b:GetAttribute(rankStat) or 0)
				if diff ~= 0 then return diff > 0 end
				return a.UserId < b.UserId
			end)
			for i, other in ipairs(entries) do
				local row, heading = add(string.format("%d  %s",i,other.DisplayName),other == player and mint or white,56)
				heading.TextTruncate = Enum.TextTruncate.AtEnd
				sub(row,string.format("$%s   ·   %d%%",fmt(other:GetAttribute("Cash")),math.floor((other:GetAttribute("Stage") or 0)*1.25)))
			end
		elseif current == "completed" then
			modalName.TextColor3 = gold
			local row, text = add(tr("completeBody"),mint,91)
			text.TextWrapped = true
			text.Size = UDim2.new(1,-24,1,-14)
			local action = add("",nil,59)
			control(action,tr("dismiss"),145,dismiss)
		end
	end

	local function open(key)
		current = key
		modalName.TextColor3 = white
		rows.CanvasPosition = Vector2.zero
		shade.Visible = true
		rerender()
	end

	local nav = {}
	for i,key in ipairs({"costumes","settings","teleport","leaderboard"}) do
		local action = button(actions,"",key=="teleport" and rgb(34,100,96) or panel,function()
			if key == "teleport" then events.Action:FireServer("teleport") else open(key) end
		end)
		action.Position,action.Size = UDim2.new((i-1)*.25,2,0,0),UDim2.new(.25,-5,1,0)
		boundedText(action,13,9)
		make("UIPadding",action,{PaddingLeft=UDim.new(0,4),PaddingRight=UDim.new(0,4)})
		nav[key] = action
	end

	local cash = make("NumberValue",nil,{Value=0})
	local cashTween, progressTween, targetCash, targetStage
	cash:GetPropertyChangedSignal("Value"):Connect(function() values.balance.Text = "$" .. fmt(math.floor(cash.Value+.5)) end)
	local function redraw()
		language = attr("Language",language)
		for key, field in pairs(metricLabels) do field.Text = tr(key) end
		for key, action in pairs(nav) do action.Text = tr(key) end
		local ready = attr("Ready",false)
		local stage, floorNumber = attr("Stage",0),attr("Floor",1)
		local floor = Floors.Names[floorNumber]
		floorLabel.Text = ready and tr("floor",floorNumber,floor[language]) or tr("loading")
		percent.Text = math.floor(stage*1.25) .. "%"
		progress.Text = tr("progress",stage)
		if targetStage ~= stage then
			targetStage = stage
			if progressTween then progressTween:Cancel() end
			progressTween = TweenService:Create(fill,TweenInfo.new(.32),{Size=UDim2.fromScale(stage/80,1)})
			progressTween:Play()
		end
		local balance = attr("Cash",0)
		if ready and targetCash ~= balance then
			targetCash = balance
			if cashTween then cashTween:Cancel() end
			cashTween = TweenService:Create(cash,TweenInfo.new(.35,Enum.EasingStyle.Quad),{Value=balance})
			cashTween:Play()
			values.balance.Text = "$" .. fmt(math.floor(cash.Value+.5))
		end
		values.income.Text = ready and "$" .. fmt(attr("Rate",0)) or "—"
		values.chest.Text = ready and "$" .. fmt(attr("Chest",0)) or "—"
		values.chest.TextColor3 = attr("Chest",0)>0 and gold or muted
		local step = attr("Tutorial",0)
		tutorial.Visible = ready and step < 5
		hint.Text = tr("tutorial" .. math.min(4,step))
	end

	local queue
	for _,key in ipairs({"Ready","Cash","Chest","Rate","Stage","Floor","Language","Tutorial","CostumesMask","Equipped","Music","Sound","Doors","PlotId"}) do
		player:GetAttributeChangedSignal(key):Connect(function()
			if queue then return end
			queue = true
			task.defer(function()
				queue = false
				redraw()
			end)
		end)
	end
	for _, key in ipairs({"Language","Stage","CostumesMask","Equipped","Music","Sound","Doors","PlotId"}) do
		player:GetAttributeChangedSignal(key):Connect(function()
			task.defer(function()
				if current then rerender() end
			end)
		end)
	end
	task.spawn(function()
		while gui.Parent do
			task.wait(1.6)
			if current == "leaderboard" then rerender() end
		end
	end)

	local hudScale, navScale, tutorialScale = make("UIScale",hud),make("UIScale",actions),make("UIScale",tutorial)
	local function fitViewport()
		local camera = workspace.CurrentCamera
		local scale = camera and camera.ViewportSize.Y < 470 and .74 or 1
		hudScale.Scale, navScale.Scale, tutorialScale.Scale = scale,scale,scale
		actions.Position = UDim2.fromOffset(12,12+173*scale)
		tutorial.Position = UDim2.fromOffset(12,12+226*scale)
	end
	local cameraSize
	local function trackCamera()
		if cameraSize then cameraSize:Disconnect() end
		local camera = workspace.CurrentCamera
		if camera then cameraSize = camera:GetPropertyChangedSignal("ViewportSize"):Connect(fitViewport) end
		fitViewport()
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(trackCamera)
	trackCamera()

	local toastToken = 0
	events.Feedback.OnClientEvent:Connect(function(kind,value)
		local text
		if kind == "collected" then text = tr(kind,fmt(value))
		elseif kind == "upgrade" and Economy.ById[value] then text = tr(kind,Economy.ById[value][language])
		elseif kind == "floor" and Floors.Names[value] then text = tr("floorOpened",Floors.Names[value][language])
		elseif kind == "costume" then
			for _, spec in ipairs(Costumes) do if spec.id == value then text = tr(kind,language == "ru" and spec.ru or spec.name) end end
		elseif kind == "completed" then open("completed") return
		else text = tr(kind) end
		if not text then return end
		toastToken += 1
		local token = toastToken
		toast.Text,toast.TextColor3,toast.TextTransparency,toast.Visible = text,kind == "short" and gold or mint,0,true
		toast.Position = UDim2.fromScale(.5,.81)
		TweenService:Create(toast,TweenInfo.new(.21,Enum.EasingStyle.Quad),{Position=UDim2.fromScale(.5,.76)}):Play()
		task.delay(2.6,function() if token == toastToken then toast.Visible = false end end)
	end)
	redraw()
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">WorldController</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
local Controller = {}

function Controller.start()
	local changes = {}
	local function applyText(item)
		local language = player:GetAttribute("Language") or (string.sub(string.lower(player.LocaleId),1,2) == "ru" and "ru" or "en")
		local property = item:GetAttribute("TextProperty")
		local text = item:GetAttribute(language=="ru" and "TextRU" or "TextEN")
		if property and text then item[property] = text end
	end
	local function addText(item)
		if changes[item] then return end
		changes[item] = item.AttributeChanged:Connect(function() applyText(item) end)
		applyText(item)
	end
	CollectionService:GetInstanceAddedSignal("FactoryText"):Connect(addText)
	CollectionService:GetInstanceRemovedSignal("FactoryText"):Connect(function(item)
		if changes[item] then changes[item]:Disconnect() changes[item] = nil end
	end)
	for _, item in ipairs(CollectionService:GetTagged("FactoryText")) do addText(item) end
	player:GetAttributeChangedSignal("Language"):Connect(function()
		for item in pairs(changes) do applyText(item) end
	end)

	local buttons = {}
	local function buttonVisible(item)
		local owner = item:GetAttribute("OwnerUserId")
		local open = player:GetAttribute("Ready") and
			(owner == player.UserId or owner == 0 and (item:GetAttribute("Interaction")~="Claim" or (player:GetAttribute("PlotId") or 0)==0))
		for _, child in ipairs(item:GetChildren()) do
			if child:IsA("ProximityPrompt") then child.Enabled = open == true end
			if child:IsA("BillboardGui") and child.Name == "Title" then child.Enabled = open == true end
		end
	end
	local function addButton(item)
		if buttons[item] then return end
		buttons[item] = item.ChildAdded:Connect(function() buttonVisible(item) end)
		buttonVisible(item)
	end
	CollectionService:GetInstanceAddedSignal("FactoryButton"):Connect(addButton)
	CollectionService:GetInstanceRemovedSignal("FactoryButton"):Connect(function(item)
		if buttons[item] then buttons[item]:Disconnect() buttons[item] = nil end
	end)
	for _, item in ipairs(CollectionService:GetTagged("FactoryButton")) do addButton(item) end
	for _, attr in ipairs({"Ready","PlotId"}) do
		player:GetAttributeChangedSignal(attr):Connect(function()
			for item in pairs(buttons) do buttonVisible(item) end
		end)
	end

	local arrow = Instance.new("BillboardGui")
	arrow.Name,arrow.Size,arrow.StudsOffsetWorldSpace = "TutorialArrow",UDim2.fromOffset(53,53),Vector3.new(0,5.4,0)
	arrow.AlwaysOnTop,arrow.MaxDistance,arrow.Enabled = true,300,false
	arrow.Parent = player:WaitForChild("PlayerGui")
	local glyph = Instance.new("TextLabel")
	glyph.Size,glyph.BackgroundTransparency = UDim2.fromScale(1,1),1
	glyph.Font,glyph.Text,glyph.TextSize = Enum.Font.GothamBold,"▼",50
	glyph.TextColor3,glyph.TextStrokeTransparency = Color3.fromRGB(117,255,185),.18
	glyph.Parent = arrow
	TweenService:Create(arrow,TweenInfo.new(.67,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut,-1,true),
		{StudsOffsetWorldSpace=Vector3.new(0,6.3,0)}):Play()
	local outline = Instance.new("Highlight")
	outline.Enabled,outline.DepthMode = false,Enum.HighlightDepthMode.AlwaysOnTop
	outline.FillTransparency,outline.OutlineColor = .8,Color3.fromRGB(117,255,185)
	outline.FillColor = outline.OutlineColor
	outline.Parent = workspace

	task.spawn(function()
		while arrow.Parent do
			local step = player:GetAttribute("Tutorial") or 0
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			local target, distance = nil,math.huge
			if root and player:GetAttribute("Ready") and step < 5 then
				if step == 2 then
					for _, marker in ipairs(CollectionService:GetTagged("FactoryLane")) do
						if marker:GetAttribute("Primary") and marker:GetAttribute("PlotId") == player:GetAttribute("PlotId") then target = marker break end
					end
				else
					local buy = step==1 or step==4 and (player:GetAttribute("Cash") or 0)>=500
					local kind = step==0 and "Claim" or buy and "Buy" or "Collect"
					for item in pairs(buttons) do
						if item:GetAttribute("Interaction")==kind and (step==0 or item:GetAttribute("OwnerUserId")==player.UserId) then
							local d = (item.Position-root.Position).Magnitude
							if d<distance then target,distance = item,d end
						end
					end
				end
			end
			arrow.Adornee,arrow.Enabled = target,target~=nil
			outline.Adornee,outline.Enabled = target,target~=nil and step~=2
			task.wait(.23)
		end
	end)
end

return Controller
]]></string>
